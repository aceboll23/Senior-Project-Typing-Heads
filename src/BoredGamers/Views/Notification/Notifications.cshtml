@model List<BoredGamers.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
    var unread = Model.Where(n => !n.IsRead).OrderByDescending(n => n.CreatedAt).ToList();
    var read = Model.Where(n => n.IsRead).OrderByDescending(n => n.CreatedAt).ToList();
}

<section class="py-4">
    <div class="container">
        <a href="/Playgroup" class="btn btn-outline-secondary btn-sm mb-4">
            <i class="bi bi-arrow-left me-1"></i>My Playgroups
        </a>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Notifications</h3>
            @if (unread.Any())
            {
                <form asp-action="MarkAllNotificationsRead" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-check-all me-1"></i>Mark All as Read
                    </button>
                </form>
            }
        </div>

        @if (!unread.Any() && !read.Any())
        {
            <div class="alert alert-info mt-3">
                No notifications.
            </div>
        }

        @if (unread.Any())
        {
            <h5 class="mt-3 mb-2">Unread</h5>
            <div class="card shadow-sm">
                <ul class="list-group list-group-flush">
                    @foreach (var notification in unread)
                    {
                        <li class="list-group-item border-start border-primary border-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong>@notification.Title</strong>
                                    <span class="badge bg-primary ms-2">New</span>
                                    <br />
                                    <span>@notification.Message</span>
                                    <br />
                                    <small class="text-muted">@notification.CreatedAt.ToString("MMM d, yyyy h:mm tt")</small>
                                </div>
                                <div class="d-flex align-items-center gap-2 ms-3">
                                    @if (notification.Type == "FriendRequest" && notification.RelatedEntityId.HasValue)
                                    {
                                        <form asp-controller="FriendRequest"
                                            asp-action="AcceptFromNotification"
                                            method="post"
                                            class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="friendshipId" value="@notification.RelatedEntityId" />
                                            <input type="hidden" name="notificationId" value="@notification.Id" />
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="bi bi-check-lg me-1"></i>Accept
                                            </button>
                                        </form>
                                        <form asp-controller="FriendRequest"
                                            asp-action="DeclineFromNotification"
                                            method="post"
                                            class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="friendshipId" value="@notification.RelatedEntityId" />
                                            <input type="hidden" name="notificationId" value="@notification.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-x-lg me-1"></i>Decline
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="MarkNotificationRead" asp-route-id="@notification.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary btn-sm" title="Mark as read">
                                                <i class="bi bi-check-lg me-1"></i>Mark As Read
                                            </button>
                                        </form>
                                        @if (!string.IsNullOrEmpty(notification.ActionUrl))
                                        {
                                            <form asp-action="ViewNotification" asp-route-id="@notification.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-primary btn-sm">
                                                    View
                                                </button>
                                            </form>
                                        }
                                    }
                                    <form asp-action="DeleteNotification" asp-route-id="@notification.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete notification">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (read.Any())
        {
            <h5 class="mt-4 mb-2 text-muted">Read</h5>
            <div class="card shadow-sm" style="opacity: 0.6;">
                <ul class="list-group list-group-flush">
                    @foreach (var notification in read)
                    {
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong class="text-muted">@notification.Title</strong>
                                    <br />
                                    <span class="text-muted">@notification.Message</span>
                                    <br />
                                    <small class="text-muted">@notification.CreatedAt.ToString("MMM d, yyyy h:mm tt")</small>
                                </div>
                                <div class="d-flex align-items-center gap-2 ms-3">
                                    @if (!string.IsNullOrEmpty(notification.ActionUrl))
                                    {
                                        <a href="@notification.ActionUrl" class="btn btn-outline-primary btn-sm">
                                            View
                                        </a>
                                    }
                                    <form asp-action="DeleteNotification" asp-route-id="@notification.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete notification">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</section>
