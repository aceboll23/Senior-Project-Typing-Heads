@model BoredGamers.Models.ViewModels.CreateGameNightEventViewModel

@{
    var isEdit = (bool)(ViewData["IsEdit"] ?? false);
    var eventId = (int?)(ViewData["EventId"] ?? null);
    ViewData["Title"] = isEdit ? "Edit Game Night Event" : "Create Game Night Event";
}

<div class="container py-4">
    <h1 class="mb-4">@(isEdit ? "Edit Game Night Event" : "Create Game Night Event")</h1>

    <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@eventId" method="post">
        <input asp-for="PlaygroupId" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @if (!string.IsNullOrWhiteSpace(Model.WarningMessage))
        {
            <div class="alert alert-warning">
                <p class="mb-2">@Model.WarningMessage</p>
                <input asp-for="ConfirmDuplicateDate" type="hidden" value="true" />
                <button type="submit" class="btn btn-warning">Create Anyway</button>
                <a asp-controller="Playgroup" asp-action="Details" asp-route-id="@Model.PlaygroupId" class="btn btn-secondary ms-2">Go Back</a>
            </div>
        }

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EventDateTime" class="form-label"></label>
            <input asp-for="EventDateTime"
                class="form-control"
                type="dateTime-local"
                value="@Model.EventDateTime.ToString("yyyy-MM-ddTHH:mm")"
                min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="EventDateTime" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        @if (string.IsNullOrWhiteSpace(Model.WarningMessage))
        {
            <button type="submit" class="btn btn-primary">@(isEdit ? "Save Changes" : "Create Event")</button>
            <a asp-controller="Playgroup" 
               asp-action="Details" 
               asp-route-id="@Model.PlaygroupId" 
               class="btn btn-secondary ms-2"
               onclick="return confirm('Are you sure you want to cancel? Any unsaved event details will be lost.');">
               Cancel
            </a>
        }
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}