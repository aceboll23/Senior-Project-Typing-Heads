@model BoredGamers.Models.GameNightEvent
@using BoredGamers.Models

@{
    ViewData["Title"] = Model.Title;
    var status = ViewData["Status"] as string;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="container py-4">
    @if (status == "added")
    {
        <div class="alert alert-success">
            Game added to event.
        </div>
    }
    @if (status == "error")
    {
        <div class="alert alert-danger">
            That game is already on this event or is not in your collection.
        </div>
    }
    @if (status == "removed")
    {
        <div class="alert alert-success">
            Game removed from event
        </div>
    }
    @if (status == "remove-error")
    {
        <div class="alert alert-danger">
            You can only remove games that you added.
        </div>
    }
    @if (status == "updated")
    {
        <div class="alert alert-success">
            Event updated successfully
        </div>
    }
    
    @if (status == "responded")
    {
        <div class="alert alert-success">
            Your response has been saved.
        </div>
    }

    <div class="mb-4">
        <h1 class="mb-2">@Model.Title</h1>
        <p class="text-muted mb-1">
            <strong>Date & Time:</strong> @Model.EventDateTime.ToString("f")
        </p>
        <p class="text-muted mb-1">
            <strong>Playgroup:</strong> @Model.Playgroup?.Name
        </p>
        <p class="text-muted mb-3">
            <strong>Created By:</strong> @Model.CreatedByUser?.UserName
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Description</h5>
                    <p class="card-text mb-0">@Model.Description</p>
                </div>
            </div>
        }

        @if (status == "voting-opened")
        {
            <div class="alert alert-success">Voting is now open.</div>
        }
        @if (status == "voting-open-error")
        {
            <div class="alert alert-danger">Could not open voting. Make sure at least one game has been added.</div>
        }
        @if (status == "voting-closed")
        {
            <div class="alert alert-success">Voting has been closed. Results are now visible.</div>
        }
        @if (status == "rankings-submitted")
        {
            <div class="alert alert-success">Your rankings have been saved.</div>
        }
        @if (status == "rankings-error")
        {
            <div class="alert alert-danger">Could not save your rankings. Voting may be closed.</div>
        }
    </div>

     <!-- RSVP Section -->
    @{
        var userResponse = ViewData["UserResponse"] as ResponseStatus?;
        var goingCount = (int)ViewData["GoingCount"]!;
        var maybeCount = (int)ViewData["MaybeCount"]!;
        var notGoingCount = (int)ViewData["NotGoingCount"]!;
        var responses = ViewData["Responses"] as List<EventResponse> ?? new List<EventResponse>();
        var responderNames = ViewData["ResponderNames"] as Dictionary<string, string> ?? new Dictionary<string, string>();
    }
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">RSVP</h5>
            <div class="d-flex gap-2 mb-3">
                <form asp-action="Respond" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="eventId" value="@Model.Id" />
                    <input type="hidden" name="status" value="@ResponseStatus.Going" />
                    <button type="submit" class="btn @(userResponse == ResponseStatus.Going ? "btn-success" : "btn-outline-success")">
                        Going (@goingCount)
                    </button>
                </form>
                <form asp-action="Respond" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="eventId" value="@Model.Id" />
                    <input type="hidden" name="status" value="@ResponseStatus.Maybe" />
                    <button type="submit" class="btn @(userResponse == ResponseStatus.Maybe ? "btn-warning" : "btn-outline-warning")">
                        Maybe (@maybeCount)
                    </button>
                </form>
                <form asp-action="Respond" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="eventId" value="@Model.Id" />
                    <input type="hidden" name="status" value="@ResponseStatus.NotGoing" />
                    <button type="submit" class="btn @(userResponse == ResponseStatus.NotGoing ? "btn-danger" : "btn-outline-danger")">
                        Not Going (@notGoingCount)
                    </button>
                </form>
            </div>
            @if (userResponse != null)
            {
                <p class="text-muted">Your response: <strong>@userResponse</strong></p>
            }
            else
            {
                <p class="text-muted">You haven't responded yet.</p>
            }

            <div class="row mt-3">
                <div class="col-md-4">
                    <h6 class="text-success"><i class="bi bi-check-circle me-1"></i>Going (@goingCount)</h6>
                    <ul class="list-unstyled ms-3">
                        @foreach (var r in responses.Where(r => r.Status == ResponseStatus.Going))
                        {
                            <li>@(responderNames.ContainsKey(r.UserId) ? responderNames[r.UserId] : "Unknown")</li>
                        }
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-warning"><i class="bi bi-question-circle me-1"></i>Maybe (@maybeCount)</h6>
                    <ul class="list-unstyled ms-3">
                        @foreach (var r in responses.Where(r => r.Status == ResponseStatus.Maybe))
                        {
                            <li>@(responderNames.ContainsKey(r.UserId) ? responderNames[r.UserId] : "Unknown")</li>
                        }
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-danger"><i class="bi bi-x-circle me-1"></i>Not Going (@notGoingCount)</h6>
                    <ul class="list-unstyled ms-3">
                        @foreach (var r in responses.Where(r => r.Status == ResponseStatus.NotGoing))
                        {
                            <li>@(responderNames.ContainsKey(r.UserId) ? responderNames[r.UserId] : "Unknown")</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>   

    <div class="mb-3 d-flex flex-wrap gap-2">
        <a asp-action="AddGame" asp-route-id="@Model.Id" class="btn btn-primary">
            Add Game From My Collection
        </a>

        @if (Model.CreatedByUserId == currentUserId)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-light">
                Edit Event
            </a>

            <form asp-action="CancelEvent" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="eventId" value="@Model.Id" />
                <button type="submit"
                    class="btn btn-outline-danger"
                    onclick="return confirm('Are you sure you want to cancel this event? This cannot be undone.');">
                    Cancel Event    
                </button>
            </form>
        }
    </div>
    @{
    var votingStatus = ViewData["VotingStatus"] as VotingStatus? ?? VotingStatus.NotStarted;
    var userRankings = ViewData["UserRankings"] as Dictionary<int, int> ?? new Dictionary<int, int>();
    var votingResults = ViewData["VotingResults"] as List<(GameNightEventGame EventGame, int TotalScore, bool IsWinner)>;
    }

    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="card-title mb-0">
                    <i class="bi bi-bar-chart me-2"></i>Game Vote
                    @if (votingStatus == VotingStatus.Open)
                    {
                        <span class="badge bg-success ms-2">Voting Open</span>
                    }
                    else if (votingStatus == VotingStatus.Closed)
                    {
                        <span class="badge bg-secondary ms-2">Voting Closed</span>
                    }
                </h5>

                @if (Model.CreatedByUserId == currentUserId)
                {
                    if (votingStatus == VotingStatus.NotStarted)
                    {
                        <form asp-action="OpenVoting" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="eventId" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="bi bi-play me-1"></i>Open Voting
                            </button>
                        </form>
                    }
                    else if (votingStatus == VotingStatus.Open)
                    {
                        <form asp-action="CloseVoting" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="eventId" value="@Model.Id" />
                            <button type="submit" class="btn btn-warning btn-sm"
                                    onclick="return confirm('Close voting? Members will no longer be able to submit rankings.');">
                                <i class="bi bi-stop me-1"></i>Close Voting
                            </button>
                        </form>
                    }
                }
            </div>

            @if (votingStatus == VotingStatus.NotStarted)
            {
                <p class="text-muted mb-0">
                    Voting has not started yet.
                    @if (Model.CreatedByUserId == currentUserId)
                    {
                        <span>Add games below then open voting when ready.</span>
                    }
                </p>
            }
            else if (votingStatus == VotingStatus.Open)
            {
                @if (!Model.EventGames.Any())
                {
                    <p class="text-muted">No games have been added to vote on yet.</p>
                }
                else
                {
                    <p class="text-muted small mb-3">
                        Rank the games below in order of preference. 1 = most preferred.
                    </p>
                    <form asp-action="SubmitRankings" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="eventId" value="@Model.Id" />
                        <div class="list-group mb-3">
                            @foreach (var eventGame in Model.EventGames)
                            {
                                var currentRank = userRankings.ContainsKey(eventGame.Id)
                                    ? userRankings[eventGame.Id]
                                    : (int?)null;
                                <div class="list-group-item bg-dark d-flex align-items-center justify-content-between gap-3">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(eventGame.Game?.ThumbnailUrl))
                                        {
                                            <img src="@eventGame.Game.ThumbnailUrl"
                                                style="width:40px;height:40px;object-fit:cover;"
                                                class="rounded" />
                                        }
                                        <span class="fw-bold">@eventGame.Game?.Name</span>
                                    </div>
                                    <div style="width:80px;">
                                        <input type="number"
                                            name="gameRanks[@eventGame.Id]"
                                            class="form-control form-control-sm text-center"
                                            min="1"
                                            max="@Model.EventGames.Count"
                                            value="@currentRank"
                                            placeholder="#" />
                                    </div>
                                </div>
                            }
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2 me-1"></i>Submit Rankings
                        </button>
                    </form>
                }
            }
            else if (votingStatus == VotingStatus.Closed && votingResults != null)
            {
                <p class="text-muted small mb-3">
                    Voting is closed. Results are based on combined preference rankings — lower score wins.
                </p>
                <div class="list-group">
                    @foreach (var (eventGame, totalScore, isWinner) in votingResults)
                    {
                        <div class="list-group-item @(isWinner ? "border-warning" : "") bg-dark d-flex align-items-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-3">
                                @if (isWinner)
                                {
                                    <i class="bi bi-trophy-fill text-warning fs-5"></i>
                                }
                                @if (!string.IsNullOrWhiteSpace(eventGame.Game?.ThumbnailUrl))
                                {
                                    <img src="@eventGame.Game.ThumbnailUrl"
                                        style="width:40px;height:40px;object-fit:cover;"
                                        class="rounded" />
                                }
                                <div>
                                    <span class="fw-bold">@eventGame.Game?.Name</span>
                                    @if (isWinner)
                                    {
                                        <span class="badge bg-warning text-dark ms-2">Winner</span>
                                    }
                                </div>
                            </div>
                            <span class="text-muted small">Score: @totalScore</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    <div>
        <h2 class="mb-3">Games Members Are Bringing</h2>

        @if (Model.EventGames == null || !Model.EventGames.Any())
        {
            <div class="alert alert-info">
                No games added yet.
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var eventGame in Model.EventGames)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100">
                            @{
                                var eventGameImg = !string.IsNullOrWhiteSpace(eventGame.Game?.ImageUrl)
                                    ? eventGame.Game.ImageUrl
                                    : eventGame.Game?.ThumbnailUrl;
                            }
                            @if (!string.IsNullOrWhiteSpace(eventGameImg))
                            {
                                <img src="@eventGameImg" class="card-img-top" alt="@eventGame.Game!.Name" style="height: 200px; object-fit: cover;" />
                            }

                            <div class="card-body">
                                <h5 class="card-title">
                                    <a asp-controller="Games" asp-action="Details" asp-route-id="@eventGame.GameId">
                                        @eventGame.Game?.Name
                                    </a>
                                </h5>
                                <p class="card-text mb-0">
                                    <strong>Brought by:</strong> @eventGame.User?.UserName
                                </p>

                                @if (eventGame.UserId == currentUserId)
                                {
                                    <form asp-action="RemoveGame" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="eventGameId" value="@eventGame.Id" />
                                        <input type="hidden" name="eventId" value="@Model.Id" />
                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to remove this game from the event?');">
                                            Remove    
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>