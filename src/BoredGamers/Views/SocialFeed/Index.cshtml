@model IReadOnlyList<BoredGamers.Models.ViewModels.SocialFeedPostViewModel>
@{
    ViewData["Title"] = "Social Feed";
}

<form id="antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<section class="py-4">
    <div class="container">
        <h3 class="mb-4"><i class="bi bi-newspaper me-2"></i>Social Feed</h3>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-people display-4 text-muted"></i>
                <p class="text-muted mt-3">No posts yet. Add some friends and check back!</p>
            </div>
        }
        else
        {
            <div id="social-feed-list">
                @foreach (var post in Model)
                {
                    <div class="card bg-dark mb-3 social-feed-post">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                @if (!string.IsNullOrEmpty(post.AuthorAvatarUrl))
                                {
                                    <img src="@post.AuthorAvatarUrl" alt="@post.AuthorUsername"
                                         class="rounded-circle me-2"
                                         style="width:36px;height:36px;object-fit:cover;">
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2"
                                         style="width:36px;height:36px;font-size:1rem;">
                                        @post.AuthorUsername.Substring(0, 1).ToUpper()
                                    </div>
                                }
                                <div>
                                    <a asp-controller="Profile" asp-action="Index"
                                       asp-route-username="@post.AuthorUsername"
                                       class="fw-bold text-white text-decoration-none">
                                        @post.AuthorUsername
                                    </a>
                                    <div class="text-muted small">
                                        @post.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy 'at' h:mm tt")
                                    </div>
                                </div>
                            </div>
                            @if (post.Category != BoredGamers.Models.PostCategory.None)
                            {
                                var badgeColor = post.Category switch {
                                    BoredGamers.Models.PostCategory.CurrentlyPlaying => "success",
                                    BoredGamers.Models.PostCategory.WantToPlay => "info",
                                    BoredGamers.Models.PostCategory.Completed => "primary",
                                    BoredGamers.Models.PostCategory.Top10 => "warning",
                                    _ => "secondary"
                                };
                                var badgeLabel = post.Category switch {
                                    BoredGamers.Models.PostCategory.CurrentlyPlaying => "Currently Playing",
                                    BoredGamers.Models.PostCategory.WantToPlay => "Want to Play",
                                    BoredGamers.Models.PostCategory.Completed => "Completed",
                                    BoredGamers.Models.PostCategory.Top10 => "Top 10",
                                    _ => ""
                                };
                                <span class="badge bg-@badgeColor mb-2">@badgeLabel</span>
                            }
                            @if (!string.IsNullOrEmpty(post.GameName))
                            {
                                <div class="small text-muted mb-1">
                                    <i class="bi bi-controller me-1"></i>
                                    <span>@post.GameName</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(post.Content))
                            {
                                <p class="mb-1">@post.Content</p>
                            }
                            @if (!string.IsNullOrEmpty(post.ImageUrl))
                            {
                                <img src="@post.ImageUrl" alt="Post image" class="img-fluid rounded mb-2"
                                     style="max-height:400px;object-fit:contain;" />
                            }
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <div class="d-flex justify-content-end mt-1">
                                    <button type="button" class="btn btn-sm btn-outline-secondary report-post-btn"
                                            data-post-id="@post.PostId"
                                            title="Report this post">
                                        <i class="bi bi-flag me-1"></i>Report
                                    </button>
                                </div>
                            }

                            @* Replies *@
                            @if (post.Replies.Any())
                            {
                                <div class="mt-3 border-top border-secondary pt-3">
                                    @foreach (var reply in post.Replies)
                                    {
                                        <div class="d-flex gap-2 mb-2" id="reply-@reply.Id">
                                            @if (!string.IsNullOrEmpty(reply.AuthorAvatarUrl))
                                            {
                                                <img src="@reply.AuthorAvatarUrl" alt="@reply.AuthorUsername"
                                                     class="rounded-circle flex-shrink-0"
                                                     style="width:28px;height:28px;object-fit:cover;">
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center flex-shrink-0"
                                                     style="width:28px;height:28px;font-size:0.75rem;">
                                                    @reply.AuthorUsername.Substring(0, 1).ToUpper()
                                                </div>
                                            }
                                            <div class="bg-secondary bg-opacity-25 rounded p-2 flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <a asp-controller="Profile" asp-action="Index"
                                                       asp-route-username="@reply.AuthorUsername"
                                                       class="fw-semibold text-white text-decoration-none small">
                                                        @reply.AuthorUsername
                                                    </a>
                                                    <span class="text-muted" style="font-size:0.75rem;">
                                                        @reply.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy 'at' h:mm tt")
                                                    </span>
                                                </div>
                                                <p class="mb-0 small">@reply.Content</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @* Reply form *@
                            <div class="mt-2">
                                <form asp-controller="ProfilePost" asp-action="Reply" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="postId" value="@post.PostId" />
                                    <div class="d-flex gap-2">
                                        <textarea name="content" class="form-control form-control-sm bg-dark text-light border-secondary"
                                                  rows="1" maxlength="500"
                                                  placeholder="Write a reply…"
                                                  id="reply-input-@post.PostId"></textarea>
                                        <button type="submit" class="btn btn-sm btn-outline-primary flex-shrink-0">
                                            <i class="bi bi-reply me-1"></i>Reply
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
