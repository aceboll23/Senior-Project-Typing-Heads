@model List<BoredGamers.Models.User>

@{
    ViewData["Title"] = "Invite Friends";
    var playgroupId = (int)ViewData["PlaygroupId"]!;
    var playgroupName = (string)ViewData["PlaygroupName"]!;
}

<section class="py-4">
    <div class="container">
        <a asp-action="Details" asp-route-id="@playgroupId" class="btn btn-outline-secondary btn-sm mb-4">
            <i class="bi bi-arrow-left me-1"></i>Back to @playgroupName
        </a>

        <h3>Invite Friends to @playgroupName</h3>

        @if (Model.Any())
        {
            <div class="card shadow-sm mt-3">
                <ul class="list-group list-group-flush">
                    @foreach (var friend in Model)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@friend.UserName</span>
                            <form asp-action="SendInvite" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="playgroupId" value="@playgroupId" />
                                <input type="hidden" name="invitedUserId" value="@friend.Id" />
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="bi bi-person-plus me-1"></i>Invite
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="alert alert-info mt-3">
                No friends available to invite. They may already be members or have pending invites.
            </div>
        }
    </div>
</section>