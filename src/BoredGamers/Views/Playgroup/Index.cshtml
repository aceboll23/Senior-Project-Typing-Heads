@model List<BoredGamers.Models.Playgroup>

@{
    ViewData["Title"] = "My Playgroups";
}

<section class="py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h4 mb-0">My Playgroups</h2>
            <a href="/Playgroup/Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Create Playgroup
            </a>
        </div>

        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-people" style="font-size: 3rem;"></i>
                <p class="mt-3 text-muted">You're not in any playgroups yet.</p>
                <a href="/Playgroup/Create" class="btn btn-outline-primary">Create your first group</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var group in Model)
                {
                    <div class="col">
                        <a href="/Playgroup/Details/@group.Id" class="text-decoration-none">
                            <div class="card bg-dark text-white h-100">
                                @if (!string.IsNullOrEmpty(group.ImageUrl))
                                {
                                    <img src="@group.ImageUrl" class="card-img-top" alt="@group.Name">
                                }
                                else
                                {
                                    <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 120px;">
                                        <i class="bi bi-people" style="font-size: 2.5rem;"></i>
                                    </div>
                                }
                                <div class="card-body">
                                    <h5 class="card-title">@group.Name</h5>
                                    @if (!string.IsNullOrEmpty(group.Description))
                                    {
                                        <p class="card-text text-muted small">@group.Description</p>
                                    }
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</section>
