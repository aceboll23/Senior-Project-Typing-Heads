@model BoredGamers.Models.Playgroup

@{
    ViewData["Title"] = Model.Name;
    var userId = (string)ViewData["UserId"]!;
    var isOwner = Model.IsOwner(userId);
    var isMember = Model.IsMember(userId);
    var memberNames = (Dictionary<string, string>)ViewData["MemberNames"]!;
    var status = ViewData["Status"] as string;
}

<section class="py-4">
    <div class="container">
        @if (status == "event-cancelled")
        {
            <div class="alert alert-success mb-4">
                Event Cancelled Successfully
            </div>
        }

        @if (status == "cannot-leave-owner")
        {
            <div class="alert alert-warning mb-4">
                Owners cannot leave the playgroup. Transfer ownership or delete the group first.
            </div>
        }

        <a href="/Playgroup" class="btn btn-outline-secondary btn-sm mb-4">
            <i class="bi bi-arrow-left me-1"></i>My Playgroups
        </a>

        <div class="row g-4">
            <!-- Group Info -->
            <div class="col-md-4">
                <div class="card shadow-sm">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center text-white" style="height: 180px;">
                            <i class="bi bi-people" style="font-size: 4rem;"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h3 class="card-title">@Model.Name</h3>
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <p class="text-muted">@Model.Description</p>
                        }
                        <small class="text-muted">
                            <i class="bi bi-people me-1"></i>@Model.MemberCount() member@(Model.MemberCount() != 1 ? "s" : "")
                        </small>
                    </div>
                </div>
            </div>

            <!-- Members List -->
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-body">
                        @if (isMember)
                        {
                            <div class="mb-3">
                                <a asp-controller="GameNightEvent"
                                    asp-action="Create"
                                    asp-route-playgroupId="@Model.Id"
                                    class="btn btn-primary">
                                    <i class="bi bi-calendar-event me-1"></i>Create Game Night Event    
                                </a>
                            </div>

                            <!-- Combined Collection Link -->
                            <div class="mb-3">
                                <a href="/Playgroup/Collection/@Model.Id" class="btn btn-outline-light">
                                    <i class="bi bi-collection me-1"></i>View Combined Collection
                                </a>
                            </div>
                            @if (isOwner)
                            {
                                <a asp-action="InviteFriends" asp-route-id="@Model.Id"
                                class="btn btn-outline-primary">
                                    <i class="bi bi-person-plus me-1"></i>Invite Friends
                                </a>
                                <a asp-action="DeletePlaygroup" asp-route-id="@Model.Id"
                                    class="btn btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i>Delete Playgroup
                                </a>
                            }
                        }
                        <h5 class="card-title mb-3">Members</h5>
                        <ul class="list-group list-group-flush">
                            @foreach (var member in Model.Members.OrderBy(m => m.Role))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@memberNames[member.UserId]</span>
                                    @if (member.Role == BoredGamers.Models.PlaygroupRole.Owner)
                                    {
                                        <span class="badge bg-primary">Owner</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Member</span>
                                    }
                                </li>
                            }
                        </ul>
                        
                        @if (isMember && !isOwner)
                        {
                            <form asp-action="LeavePlaygroup" asp-route-id="@Model.Id" method="post" class="mt-3">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                        onclick="return confirm('Are you sure you want to leave this playgroup?')">
                                    <i class="bi bi-box-arrow-right me-1"></i>Leave Playgroup
                                </button>
                            </form>
                        }

                    </div>
                </div>
            </div>
        </div>

        <!-- Upcoming Events -->
        @if (isMember)
        {
            <div class="row mt-4">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title mb-3">
                                <i class="bi bi-calendar-event me-1"></i>Events
                            </h5>
                            @if (Model.GameNightEvents.Any())
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var evt in Model.GameNightEvents.OrderBy(e => e.EventDateTime))
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@evt.Title</strong>
                                                <br />
                                                <small class="text-muted">@evt.EventDateTime.ToString("ddd, MMM d yyyy · h:mm tt")</small>
                                                @if (!string.IsNullOrEmpty(evt.Description))
                                                {
                                                    <br />
                                                    <small>@evt.Description</small>
                                                }
                                            </div>
                                            <a asp-controller="GameNightEvent"
                                               asp-action="Details"
                                               asp-route-id="@evt.Id"
                                               class="btn btn-outline-primary btn-sm">
                                                View
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted mb-0">No events yet. Create one to get started!</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
