@using BoredGamers.Models
@{
    ViewData["Title"] = "Messages";
    var currentProfileId = (int)ViewData["CurrentProfileId"]!;
    var friendConversations = ViewData["FriendConversations"] as List<DirectMessage> ?? new();
    var messageRequests = ViewData["MessageRequests"] as List<DirectMessage> ?? new();
    var allProfiles = ViewData["AllProfiles"] as List<UserProfile> ?? new();
}

<section class="py-4">
    <div class="container">
        <h2 class="mb-4">Messages</h2>

        <!-- Friend Messages -->
        <h5 class="mb-3">
            <i class="bi bi-chat-dots me-2"></i>Friends
        </h5>

        @if (!friendConversations.Any())
        {
            <p class="text-muted mb-4">No messages yet. Send a message from a friend's profile.</p>
        }
        else
        {
            <div class="list-group mb-4">
                @foreach (var msg in friendConversations)
                {
                    var otherProfileId = msg.SenderProfileId == currentProfileId ? msg.RecipientProfileId : msg.SenderProfileId;
                    var otherProfile = allProfiles.FirstOrDefault(p => p.Id == otherProfileId);
                    var otherUsername = otherProfile?.User?.UserName ?? "Unknown";
                    var otherAvatar = otherProfile?.AvatarUrl;
                    var isUnread = msg.RecipientProfileId == currentProfileId && msg.Status != MessageStatus.Read;

                    <div class="list-group-item bg-dark d-flex align-items-center gap-3 @(isUnread ? "border-primary" : "")">
                        <a href="/Messages/Conversation/@otherUsername"
                           class="d-flex align-items-center gap-3 flex-grow-1 text-decoration-none overflow-hidden">
                            @if (!string.IsNullOrEmpty(otherAvatar))
                            {
                                <img src="@otherAvatar" class="rounded-circle"
                                     style="width:48px;height:48px;object-fit:cover;">
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width:48px;height:48px;font-size:1.2rem;">
                                    @otherUsername.Substring(0, 1).ToUpper()
                                </div>
                            }
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-bold @(isUnread ? "text-white" : "text-muted")">
                                        @otherUsername
                                    </span>
                                    <small class="text-muted">@msg.SentAt.ToString("MMM dd")</small>
                                </div>
                                <div class="text-muted text-truncate small">
                                    @(msg.SenderProfileId == currentProfileId ? "You: " : "")@msg.Content
                                </div>
                            </div>
                        </a>
                        @if (isUnread)
                        {
                            <span class="badge bg-primary rounded-pill">New</span>
                        }
                        <form asp-controller="Messages" asp-action="DeleteConversation" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="otherUsername" value="@otherUsername" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Delete this conversation? The other person will still see your messages, and the conversation will reappear if they message you again.');"
                                    title="Delete conversation">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }

        <!-- Message Requests -->
        @if (messageRequests.Any())
        {
            <h5 class="mb-3 text-muted">
                <i class="bi bi-envelope me-2"></i>Message Requests
                <span class="badge bg-secondary ms-1">@messageRequests.Count</span>
            </h5>
            <p class="text-muted small mb-3">
                Messages from people you are not friends with.
            </p>
            <div class="list-group">
                @foreach (var msg in messageRequests)
                {
                    var otherProfileId = msg.SenderProfileId == currentProfileId ? msg.RecipientProfileId : msg.SenderProfileId;
                    var otherProfile = allProfiles.FirstOrDefault(p => p.Id == otherProfileId);
                    var otherUsername = otherProfile?.User?.UserName ?? "Unknown";
                    var isUnread = msg.RecipientProfileId == currentProfileId && msg.Status != MessageStatus.Read;

                    <div class="list-group-item bg-dark d-flex align-items-center gap-3">
                        <a href="/Messages/Conversation/@otherUsername"
                           class="d-flex align-items-center gap-3 flex-grow-1 text-decoration-none overflow-hidden">
                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width:48px;height:48px;font-size:1.2rem;">
                                @otherUsername.Substring(0, 1).ToUpper()
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <span class="fw-bold @(isUnread ? "text-white" : "text-muted")">
                                    @otherUsername
                                </span>
                                <div class="text-muted text-truncate small">@msg.Content</div>
                            </div>
                        </a>
                        <form asp-controller="Messages" asp-action="DeleteConversation" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="otherUsername" value="@otherUsername" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Delete this conversation? The other person will still see your messages.');"
                                    title="Delete conversation">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</section>