@using BoredGamers.Models
@{
    ViewData["Title"] = "Conversation";
    var currentProfileId = (int)ViewData["CurrentProfileId"]!;
    var otherUsername = ViewData["OtherUsername"] as string;
    var otherAvatarUrl = ViewData["OtherAvatarUrl"] as string;
    var otherProfileId = (int)ViewData["OtherProfileId"]!;
    var isFriend = (bool)(ViewData["IsFriend"] ?? false);
    var messages = ViewData["Messages"] as List<DirectMessage> ?? new();
}

<section class="py-4">
    <div class="container">
        <!-- Conversation Header -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <a href="/Messages" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i>
            </a>
            @if (!string.IsNullOrEmpty(otherAvatarUrl))
            {
                <img src="@otherAvatarUrl" class="rounded-circle"
                     style="width:48px;height:48px;object-fit:cover;">
            }
            else
            {
                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                     style="width:48px;height:48px;font-size:1.2rem;">
                    @otherUsername?.Substring(0, 1).ToUpper()
                </div>
            }
            <div>
                <a href="/Profile/@otherUsername" class="fw-bold text-white text-decoration-none">
                    @otherUsername
                </a>
                @if (!isFriend)
                {
                    <div class="text-muted small">Not a friend</div>
                }
            </div>
        </div>

        <!-- Message History -->
        <div id="messageHistory"
             class="card bg-dark p-3 mb-3"
             style="height:450px;overflow-y:auto;">
            @if (!messages.Any())
            {
                <p class="text-muted text-center mt-5">
                    No messages yet. Say hello!
                </p>
            }
            else
            {
                @foreach (var msg in messages)
                {
                    var isMine = msg.SenderProfileId == currentProfileId;
                    <div class="d-flex @(isMine ? "justify-content-end" : "justify-content-start") mb-2">
                        <div class="@(isMine ? "bg-primary" : "bg-secondary") text-white rounded p-2"
                             style="max-width:70%;">
                            <div>@msg.Content</div>
                            <div class="d-flex justify-content-end align-items-center gap-1 mt-1">
                                <small class="text-white-50">
                                    @msg.SentAt.ToString("MMM dd, h:mm tt")
                                </small>
                                @if (isMine)
                                {
                                    @if (msg.Status == MessageStatus.Read)
                                    {
                                        <i class="bi bi-check2-all text-info small" title="Read"></i>
                                    }
                                    else if (msg.Status == MessageStatus.Delivered)
                                    {
                                        <i class="bi bi-check2-all text-white-50 small" title="Delivered"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check2 text-white-50 small" title="Sent"></i>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Message Input -->
        <div class="card bg-dark p-3">
            <div id="sendError" class="alert alert-danger d-none mb-2"></div>
            <div class="d-flex gap-2">
                <textarea id="messageInput"
                          class="form-control bg-dark text-white"
                          rows="2"
                          maxlength="1000"
                          placeholder="Type a message..."></textarea>
                <button id="sendBtn" class="btn btn-primary align-self-end">
                    <i class="bi bi-send"></i>
                </button>
            </div>
            <div class="d-flex justify-content-end mt-1">
                <small class="text-muted">
                    <span id="charCount">0</span>/1000
                </small>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
$(document).ready(function () {
    const recipientUsername = '@otherUsername';
    const currentProfileId = @currentProfileId;
    const otherProfileId = @otherProfileId;
    const token = $('input[name="__RequestVerificationToken"]').first().val();
    const $history = $('#messageHistory');
    const $input = $('#messageInput');
    const $sendBtn = $('#sendBtn');
    const $charCount = $('#charCount');
    const $sendError = $('#sendError');

    // Scroll to bottom on load
    $history.scrollTop($history[0].scrollHeight);

    // Character counter
    $input.on('input', function () {
        $charCount.text($input.val().length);
    });

    function escapeHtml(str) {
        return $('<div>').text(str).html();
    }

    function appendMessage(content, sentAt, isMine) {
        const alignment = isMine ? 'justify-content-end' : 'justify-content-start';
        const bubble = isMine ? 'bg-primary' : 'bg-secondary';
        const icon = isMine ? '<i class="bi bi-check2 text-white-50 small" title="Sent"></i>' : '';

        const msgHtml = `
            <div class="d-flex ${alignment} mb-2">
                <div class="${bubble} text-white rounded p-2" style="max-width:70%;">
                    <div>${escapeHtml(content)}</div>
                    <div class="d-flex justify-content-end align-items-center gap-1 mt-1">
                        <small class="text-white-50">${escapeHtml(sentAt)}</small>
                        ${icon}
                    </div>
                </div>
            </div>`;

        $history.append(msgHtml);
        $history.scrollTop($history[0].scrollHeight);
    }
    // Mark this conversation as actively viewed so the global notification sound
    // doesn't play when messages from this user arrive
    sessionStorage.setItem('activeConversation', recipientUsername);

    // Clear it when the user leaves the page
    window.addEventListener('beforeunload', function () {
        sessionStorage.removeItem('activeConversation');
    });

    // SignalR — real-time incoming messages
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/direct-message")
        .withAutomaticReconnect()
        .build();

    connection.on("ReceiveMessage", function (data) {
        // Only append if the message is from the other person
        // Our own messages are appended optimistically on send
        if (data.senderProfileId !== currentProfileId) {
            appendMessage(data.content, data.sentAt, false);
        }
        // Mark as read since the user is actively viewing
        $.post('/Messages/MarkAsRead',
            { otherUsername: recipientUsername, __RequestVerificationToken: token });
    });

    // Build conversation key the same way the server does — sorted profile IDs
    const sorted = [currentProfileId, otherProfileId].sort((a, b) => a - b);
    const conversationKey = `dm-${sorted[0]}-${sorted[1]}`;

    connection.start()
        .then(() => connection.invoke("JoinConversation", conversationKey))
        .catch(err => console.error("SignalR error:", err));

    // Send on button click
    $sendBtn.on('click', function () {
        sendMessage();
    });

    // Send on Enter
    $input.on('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    });

    function sendMessage() {
        const content = $input.val().trim();

        if (!content) {
            showError('Message cannot be empty.');
            return;
        }

        if (content.length > 1000) {
            showError('Message cannot exceed 1000 characters.');
            return;
        }

        $sendBtn.prop('disabled', true);
        $sendError.addClass('d-none');

        $.post('/Messages/Send',
            {
                recipientUsername: recipientUsername,
                content: content,
                __RequestVerificationToken: token
            },
            function (response) {
                if (response.success) {
                    // Optimistically append our own message immediately
                    appendMessage(response.content, response.sentAt, true);
                    $input.val('');
                    $charCount.text('0');
                } else {
                    showError(response.message);
                }
                $sendBtn.prop('disabled', false);
            }
        ).fail(function (xhr) {
            showError('Failed to send message. Please try again.');
            $sendBtn.prop('disabled', false);
        });
    }

    function showError(msg) {
        $sendError.text(msg).removeClass('d-none');
    }
});
</script>
}