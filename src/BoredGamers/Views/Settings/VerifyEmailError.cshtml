@{
    ViewData["Title"] = "Verification Failed";
}
<section class="bg-dark text-white py-5">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center">
                <i class="bi bi-x-circle display-1 text-danger mb-4"></i>
                <h1 class="display-5 fw-bold mb-3">Verification Failed</h1>
                <p class="lead">@ViewData["ErrorMessage"]</p>
                <a asp-controller="Settings" asp-action="Index" class="btn btn-primary mt-3">
                    Back to Settings
                </a>
            </div>
        </div>
    </div>
</section>