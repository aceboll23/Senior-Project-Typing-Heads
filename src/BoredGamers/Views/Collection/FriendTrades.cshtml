@model List<BoredGamers.Models.Game>

@{
    var friendUsername = ViewData["FriendUsername"] as string;
    ViewData["Title"] = friendUsername + "'s Available Trades";
}

<section class="py-4">
    <div class="container">
        <div class="mb-3">
            <a href="/Profile/@friendUsername" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to @friendUsername's Profile
            </a>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1 class="mb-1" id="trades-heading">@friendUsername's Available Trades</h1>
                <div class="text-muted">@(Model?.Count ?? 0) game(s) available for trade</div>
            </div>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-secondary" id="trades-empty-msg">
                @friendUsername does not currently have any games available for trade.
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var g in Model)
                {
                    var image = !string.IsNullOrWhiteSpace(g.ImageUrl)
                        ? g.ImageUrl
                        : !string.IsNullOrWhiteSpace(g.ThumbnailUrl)
                            ? g.ThumbnailUrl
                            : Url.Content("~/images/game-placeholder.png");

                    <div class="col-12 col-sm-6 col-lg-3" id="trade-game-@g.Id">
                        <a class="text-decoration-none"
                           asp-controller="GamesPage"
                           asp-action="Details"
                           asp-route-id="@g.Id">
                            <div class="card h-100 shadow-sm bg-dark text-light border-0">
                                <img src="@image" alt="@g.Name" class="card-img-top" style="height: 280px; object-fit: cover;" />
                                <div class="card-body">
                                    <span class="badge bg-success mb-2">Available for Trade</span>
                                    <h5 class="card-title mb-2">@g.Name</h5>
                                    <div class="text-muted small mb-2">
                                        @(g.BggNumVoters.HasValue ? $"{g.BggNumVoters.Value:N0} BGG voters" : "—")
                                        |
                                        @(g.YearPublished.HasValue ? g.YearPublished.Value.ToString() : "—")
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-warning">
                                            <i class="bi bi-star-fill me-1"></i>
                                        </span>
                                        <span class="fw-semibold">
                                            @(g.AverageRating.HasValue ? $"{g.AverageRating.Value:0.0}/10" : "—")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</section>
