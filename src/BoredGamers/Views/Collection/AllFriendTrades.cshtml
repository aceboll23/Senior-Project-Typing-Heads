@model List<BoredGamers.Models.ViewModels.FriendTradeItem>

@{
    var page = (int)(ViewData["Page"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var totalCount = (int)(ViewData["TotalCount"] ?? 0);
    ViewData["Title"] = "Friends' Available Trades";
}

<section class="py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1 class="mb-1">Friends' Available Trades</h1>
                <div class="text-muted">@totalCount game(s) available across your friends</div>
            </div>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-secondary" id="all-trades-empty-msg">
                None of your friends currently have any games available for trade.
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    var g = item.Game;
                    var image = !string.IsNullOrWhiteSpace(g.ThumbnailUrl)
                        ? g.ThumbnailUrl
                        : !string.IsNullOrWhiteSpace(g.ImageUrl)
                            ? g.ImageUrl
                            : Url.Content("~/images/game-placeholder.png");

                    <div class="col-12 col-sm-6 col-lg-3" id="trade-item-@g.Id-@item.OwnerUsername">
                        <div class="card h-100 shadow-sm bg-dark text-light border-0">
                            <a class="text-decoration-none"
                               asp-controller="GamesPage"
                               asp-action="Details"
                               asp-route-id="@g.Id">
                                <img src="@image" alt="@g.Name" class="card-img-top" style="height: 240px; object-fit: cover;" />
                            </a>
                            <div class="card-body d-flex flex-column">
                                <span class="badge bg-success mb-2">Available for Trade</span>
                                <h5 class="card-title mb-1">
                                    <a class="text-light text-decoration-none"
                                       asp-controller="GamesPage"
                                       asp-action="Details"
                                       asp-route-id="@g.Id">@g.Name</a>
                                </h5>
                                <div class="text-muted small mb-2">
                                    <a class="text-muted text-decoration-none"
                                       asp-controller="Profile"
                                       asp-action="Index"
                                       asp-route-username="@item.OwnerUsername">
                                        <i class="bi bi-person me-1"></i>@item.OwnerUsername
                                    </a>
                                </div>
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <span class="text-warning"><i class="bi bi-star-fill me-1"></i></span>
                                    <span class="fw-semibold">@(g.AverageRating.HasValue ? $"{g.AverageRating.Value:0.0}/10" : "—")</span>
                                    <span class="text-muted small">@(g.YearPublished.HasValue ? g.YearPublished.Value.ToString() : "")</span>
                                </div>
                                <div class="mt-auto">
                                    <a class="btn btn-outline-primary btn-sm w-100"
                                       asp-controller="Messages"
                                       asp-action="Conversation"
                                       asp-route-username="@item.OwnerUsername"
                                       id="msg-btn-@item.OwnerUsername-@g.Id">
                                        <i class="bi bi-chat-dots me-1"></i>Message @item.OwnerUsername
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (totalPages > 1)
            {
                <nav class="mt-4" aria-label="Trades pagination">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(page <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="AllFriendTrades" asp-route-page="@(page - 1)">Previous</a>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == page ? "active" : "")">
                                <a class="page-link" asp-action="AllFriendTrades" asp-route-page="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(page >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="AllFriendTrades" asp-route-page="@(page + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</section>
