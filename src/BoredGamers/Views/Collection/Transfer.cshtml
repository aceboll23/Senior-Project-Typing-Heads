@model BoredGamers.Models.Game

@{
    ViewData["Title"] = "Transfer Game";
    var image = !string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? Model.ImageUrl
        : !string.IsNullOrWhiteSpace(Model.ThumbnailUrl)
            ? Model.ThumbnailUrl
            : Url.Content("~/images/game-placeholder.png");
}

<section class="py-4">
    <div class="container" style="max-width: 540px;">
        <div class="mb-3">
            <a asp-controller="Collection" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to My Collection
            </a>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <h1 class="mb-4">Transfer Game</h1>

        <div class="card bg-dark text-light border-0 shadow-sm mb-4">
            <div class="row g-0">
                <div class="col-4">
                    <img src="@image" alt="@Model.Name" class="img-fluid rounded-start" style="height: 140px; object-fit: cover; width: 100%;" />
                </div>
                <div class="col-8">
                    <div class="card-body">
                        <h5 class="card-title">@Model.Name</h5>
                        <div class="text-muted small">@(Model.YearPublished.HasValue ? Model.YearPublished.Value.ToString() : "—")</div>
                    </div>
                </div>
            </div>
        </div>

        <form asp-controller="Collection" asp-action="Transfer" asp-route-gameId="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label for="toUsername" class="form-label">Transfer to (username)</label>
                <input type="text" class="form-control" id="toUsername" name="toUsername"
                       placeholder="Enter username" autocomplete="off" required />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning" id="transfer-preview-btn">
                    <i class="bi bi-arrow-right me-1"></i>Next: Review Transfer
                </button>
                <a asp-controller="Collection" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</section>
