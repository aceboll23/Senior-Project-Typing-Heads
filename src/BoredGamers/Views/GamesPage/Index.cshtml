@model IReadOnlyList<BoredGamers.Models.Game>

@{
    ViewData["Title"] = "Browse Games";
    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var maxPlayTime = ViewData["MaxPlayTime"] as int?;
    var playerCount = ViewData["PlayerCount"] as int?;
    var minRating = ViewData["MinRating"] as decimal?;
}

<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">Browse Games</h1>
        </div>

        <form method ="get" action="/Games" class="row g-3 mb-4">
            <div class="col-md-2">
                <label for="maxPlayTime" class="form-label">Play Time (min)</label>
                <input type="number" class="form-control" id="maxPlayTime" name="maxPlayTime" value="@maxPlayTime" value="@maxPlayTime" min="1" />
            </div>
            <div class="col-md-2">
                <label for="playerCount" class="form-label">Player Count</label>
                <input type="number" class="form-control" id="playerCount" name="playerCount" value="@playerCount" value="@playerCount" min="1" />
            </div>
            <div class="col-md-2">
                <label for="minRating" class="form-label">Minimum Rating</label>
                <input type="number" step="0.1" class="form-control" id="minRating" name="minRating" value="@minRating" min="0" max="10" step="0.1" />
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Apply Filters</button>
            </div>
        </form>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-secondary" role="alert">
                No games found with the current filters. Try adjusting the criteria or check back later as we add more games to our collection!
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
                @foreach (var game in Model)
                {
                    <div class="col">
                        <a asp-controller="Games"
                           asp-action="Details"
                           asp-route-id="@game.Id"
                           class="card bg-dark text-white text-decoration-none h-100">

                            @{
                                var img = string.IsNullOrWhiteSpace(game.ThumbnailUrl)
                                    ? Url.Content("~/images/game-placeholder.png")
                                    : game.ThumbnailUrl;
                            }

                            <img src="@img" class="card-img-top" alt="@game.Name" style="height: 260px; object-fit: cover;" />

                            <div class="card-body">
                                <h6 class="card-title">@game.Name</h6>

                                <small class="text-muted">
                                    @(game.BggNumVoters?.ToString() ?? "—") BGG voters
                                    @if (game.YearPublished.HasValue)
                                    {
                                        <span> | @game.YearPublished</span>
                                    }
                                </small>

                                @if (game.AverageRating.HasValue)
                                {
                                    <div class="mt-2">
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <span>@game.AverageRating.Value.ToString("0.0")/10</span>
                                    </div>
                                }
                            </div>
                        </a>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-between mt-4">
                @if (currentPage > 1)
                {
                    <a href="/Games?page=@(currentPage - 1)&maxPlayTime=@maxPlayTime&playerCount=@playerCount&minRating=@minRating" class="btn btn-outline-light">
                        Previous
                    </a>
                }
                else
                {
                    <span></span>
                }

                <span class="text-muted">Page @currentPage</span>

                <a href="/Games?page=@(currentPage + 1)&maxPlayTime=@maxPlayTime&playerCount=@playerCount&minRating=@minRating" class="btn btn-outline-light">
                    Next
                </a>
            </div>
        }
    </div>
</section>