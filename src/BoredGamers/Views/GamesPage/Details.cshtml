@model BoredGamers.Models.Game

@{
    ViewData["Title"] = Model.Name;

    var image = !string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? Model.ImageUrl
        : !string.IsNullOrWhiteSpace(Model.ThumbnailUrl)
            ? Model.ThumbnailUrl
            : Url.Content("~/images/game-placeholder.png");

    string playersText = (Model.MinPlayers.HasValue || Model.MaxPlayers.HasValue)
        ? (Model.MinPlayers.HasValue && Model.MaxPlayers.HasValue
            ? (Model.MinPlayers == Model.MaxPlayers
                ? $"{Model.MinPlayers} players"
                : $"{Model.MinPlayers}-{Model.MaxPlayers} players")
            : (Model.MinPlayers.HasValue
                ? $"{Model.MinPlayers}+ players"
                : $"Up to {Model.MaxPlayers} players"))
        : "—";

    string playTimeText = Model.PlayTime.HasValue ? $"{Model.PlayTime} min" : "—";
    string yearText = Model.YearPublished.HasValue ? Model.YearPublished.Value.ToString() : "—";
    string ratingText = Model.AverageRating.HasValue ? Model.AverageRating.Value.ToString("0.0") : "—";
    string votersText = Model.BggNumVoters.HasValue ? Model.BggNumVoters.Value.ToString("N0") : "—";

    bool hasDescription = !string.IsNullOrWhiteSpace(Model.Description);
}

<!-- Game Details -->
<section class="py-4">
    <div class="container">

        <!-- Back link -->
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm mb-4">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>

        <div class="row g-4 align-items-start">
            <!-- Game Image -->
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <img src="@image" alt="@Model.Name" class="img-fluid rounded-top" />
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2">
                            @if (Model.AverageRating.HasValue)
                            {
                                <span class="badge bg-secondary fs-6">
                                    <i class="bi bi-star-fill me-1"></i>@Model.AverageRating.Value.ToString("0.0") / 10
                                </span>
                            }

                            @if (Model.BggNumVoters.HasValue)
                            {
                                <span class="badge bg-light text-dark border fs-6">
                                    <i class="bi bi-people me-1"></i>@Model.BggNumVoters.Value.ToString("N0") voters
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Game Info -->
            <div class="col-md-8">
                <div class="d-flex flex-column gap-3">

                    <!-- Title -->
                    <div>
                        <h1 class="mb-1">@Model.Name</h1>
                        <div class="text-muted">
                            <span class="me-3"><i class="bi bi-calendar3 me-1"></i>Year: <strong>@yearText</strong></span>
                        </div>
                    </div>

                    <!-- Quick Stats -->
                    <div class="row g-3">
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="text-muted small">Average Rating</div>
                                    <div class="fs-4 fw-semibold">
                                        <i class="bi bi-star-fill me-1"></i>@ratingText
                                    </div>
                                    <div class="text-muted small">out of 10</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="text-muted small">BGG Voters</div>
                                    <div class="fs-4 fw-semibold">
                                        <i class="bi bi-people me-1"></i>@votersText
                                    </div>
                                    <div class="text-muted small">users rated</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="text-muted small">Players</div>
                                    <div class="fs-4 fw-semibold">
                                        <i class="bi bi-person-badge me-1"></i>@playersText
                                    </div>
                                    <div class="text-muted small">recommended range</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="text-muted small">Play Time</div>
                                    <div class="fs-4 fw-semibold">
                                        <i class="bi bi-clock me-1"></i>@playTimeText
                                    </div>
                                    <div class="text-muted small">approx.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title mb-3">Description</h5>

                            @if (hasDescription)
                            {
                                <p class="mb-0" style="white-space: pre-line;">
                                    @Model.Description
                                </p>
                            }
                            else
                            {
                                <p class="text-muted mb-0">No description available yet.</p>
                            }
                        </div>
                    </div>

                    <!-- Optional helper note if data missing -->
                    @if (!Model.MinPlayers.HasValue && !Model.MaxPlayers.HasValue && !Model.PlayTime.HasValue && !Model.YearPublished.HasValue)
                    {
                        <div class="alert alert-warning mb-0">
                            Some game metadata is missing. Try running your BGG sync/backfill again.
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</section>
