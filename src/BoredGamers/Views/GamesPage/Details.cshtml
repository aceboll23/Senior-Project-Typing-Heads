@model BoredGamers.Models.Game

@using System.Linq

@{
    ViewData["Title"] = Model.Name;

    var image = !string.IsNullOrWhiteSpace(Model.ImageUrl)
    ? Model.ImageUrl
    : !string.IsNullOrWhiteSpace(Model.ThumbnailUrl)
    ? Model.ThumbnailUrl
    : Url.Content("~/images/game-placeholder.png");

    string playersText = (Model.MinPlayers.HasValue || Model.MaxPlayers.HasValue)
    ? (Model.MinPlayers.HasValue && Model.MaxPlayers.HasValue
    ? (Model.MinPlayers == Model.MaxPlayers
    ? $"{Model.MinPlayers} players"
    : $"{Model.MinPlayers}-{Model.MaxPlayers} players")
    : (Model.MinPlayers.HasValue
    ? $"{Model.MinPlayers}+ players"
    : $"Up to {Model.MaxPlayers} players"))
    : "—";

    string playTimeText = Model.PlayTime.HasValue ? $"{Model.PlayTime} min" : "—";
    string yearText = Model.YearPublished.HasValue ? Model.YearPublished.Value.ToString() : "—";
    string ratingText = Model.AverageRating.HasValue ? Model.AverageRating.Value.ToString("0.0") : "—";
    string votersText = Model.BggNumVoters.HasValue ? Model.BggNumVoters.Value.ToString("N0") : "—";

    bool hasDescription = !string.IsNullOrWhiteSpace(Model.Description);

    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<!-- Game Details -->
<section class="py-4">
    <div class="container">

        <!-- Back link -->
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm mb-4">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>

        <div class="row g-4 align-items-start">
            <!-- Game Image -->
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <img src="@image" alt="@Model.Name" class="img-fluid rounded-top" />
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2">
                            @if (Model.AverageRating.HasValue)
                            {
                                <span class="badge bg-secondary fs-6">
                                    <i class="bi bi-star-fill me-1"></i>@Model.AverageRating.Value.ToString("0.0") / 10
                                </span>
                            }

                            @if (Model.BggNumVoters.HasValue)
                            {
                                <span class="badge bg-light text-dark border fs-6">
                                    <i class="bi bi-people me-1"></i>@Model.BggNumVoters.Value.ToString("N0") voters
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Game Info -->
            <div class="col-md-8">
                <div class="d-flex flex-column gap-3">

                    <!-- Title -->
                    <div>
                        <h1 class="mb-1">@Model.Name</h1>
                        <div class="text-muted">
                            <span class="me-3"><i class="bi bi-calendar3 me-1"></i>Year:
                                <strong>@yearText</strong></span>
                            </div>
                        </div>

                        <!-- Add to Collection / Wishlist -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var inCollection = (bool)(ViewBag.IsInCollection ?? false);
                            var onWishlist = (bool)(ViewBag.IsOnWishlist ?? false);

                            <div class="mt-3 d-flex flex-wrap gap-2">
                                @if (inCollection)
                                {
                                    <button class="btn btn-secondary" disabled>
                                        <i class="bi bi-check-circle me-1"></i>In Collection
                                    </button>
                                }
                                else
                                {
                                    <form asp-controller="Collection" asp-action="Add" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="gameId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-plus-circle me-1"></i>Add to Collection
                                        </button>
                                    </form>
                                }

                                @if (inCollection)
                                {
                                    <!-- Already owned — no need for wishlist -->
                                }
                                else if (onWishlist)
                                {
                                    <button id="addToWishlistBtn" class="btn btn-outline-secondary" disabled>
                                        <i class="bi bi-bookmark-check me-1"></i>On Wishlist
                                    </button>
                                }
                                else
                                {
                                    <form asp-controller="Collection" asp-action="AddToWishlist" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="gameId" value="@Model.Id" />
                                        <button id="addToWishlistBtn" type="submit" class="btn btn-outline-primary">
                                            <i class="bi bi-bookmark-plus me-1"></i>Add to Wishlist
                                        </button>
                                    </form>
                                }
                            </div>
                        }

                        <!-- Quick Stats -->
                        <div class="row g-3">
                            <div class="col-12 col-sm-6 col-lg-3">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body">
                                        <div class="text-muted small">Average Rating</div>
                                        <div class="fs-4 fw-semibold">
                                            <i class="bi bi-star-fill me-1"></i>@ratingText
                                        </div>
                                        <div class="text-muted small">out of 10</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-lg-3">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body">
                                        <div class="text-muted small">BGG Voters</div>
                                        <div class="fs-4 fw-semibold">
                                            <i class="bi bi-people me-1"></i>@votersText
                                        </div>
                                        <div class="text-muted small">users rated</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-lg-3">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body">
                                        <div class="text-muted small">Players</div>
                                        <div class="fs-4 fw-semibold">
                                            <i class="bi bi-person-badge me-1"></i>@playersText
                                        </div>
                                        <div class="text-muted small">recommended range</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-lg-3">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body">
                                        <div class="text-muted small">Play Time</div>
                                        <div class="fs-4 fw-semibold">
                                            <i class="bi bi-clock me-1"></i>@playTimeText
                                        </div>
                                        <div class="text-muted small">approx.</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title mb-3">Description</h5>

                                @if (hasDescription)
                                {
                                    <p class="mb-0" style="white-space: pre-line;">
                                        @Model.Description
                                    </p>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">No description available yet.</p>
                                }
                            </div>
                        </div>

                        <!-- Optional helper note if data missing -->
                        @if (!Model.MinPlayers.HasValue && !Model.MaxPlayers.HasValue && !Model.PlayTime.HasValue &&
                                            !Model.YearPublished.HasValue)
                        {
                            <div class="alert alert-warning mb-0">
                                Some game metadata is missing. Try running your BGG sync/backfill again.
                            </div>
                        }

                        <!--Reviews-->
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title mb-3">Reviews</h5>

                                @{
                                    var averageUserRating = ViewBag.AverageUserRating as decimal?;
                                }
                                @if (averageUserRating.HasValue)
                                {
                                    <div id="average-user-rating" class="mb-3">
                                        <span class="badge bg-primary fs-6">
                                            <i class="bi bi-star-fill me-1"></i>
                                            Average User Rating: @averageUserRating.Value.ToString("0.0") / 10
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div id="average-user-rating" class="mb-3 text-muted">
                                        No user ratings yet.
                                    </div>
                                }

                                @if (TempData["ReviewSuccess"] != null)
                                {
                                    <div class="alert alert-success">@TempData["ReviewSuccess"]</div>
                                }
                                @if (TempData["ReviewError"] != null)
                                {
                                    <div class="alert alert-danger">@TempData["ReviewError"]</div>
                                }

                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    var hasReviewed = Model.Reviews != null &&
                                    Model.Reviews.Any(r => r.UserId == currentUserId);

                                    if (hasReviewed)
                                    {
                                        <div class="alert alert-info mb-3">
                                            You've already reviewed this game.
                                        </div>
                                    }
                                    else
                                    {
                                        <h6 class="mb-2">Write a review</h6>

                                        <form asp-controller="Reviews" asp-action="Create" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="gameId" value="@Model.Id" />

                                            <div class="mb-3">
                                                <label class="form-label" for="rating">Rating (1-10)</label>
                                                <select class="form-select" id="rating" name="rating" required>
                                                    @for (int i = 1; i <= 10; i++)
                                                    {
                                                        <option value="@i">@i</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label" for="text">Review</label>
                                                <textarea class="form-control" id="text" name="text" rows="4" required></textarea>
                                            </div>

                                            <button type="submit" class="btn btn-primary">
                                                <i class="bi bi-send me-1"></i>Submit Review
                                            </button>
                                        </form>
                                    }
                                }
                                else
                                {
                                    <p class="mb-0">
                                        <a asp-controller="Account" asp-action="Login">Log in</a> to write a review.
                                    </p>
                                }

                                <hr class="my-4" />

                                @{
                                    var sortedReviews = ViewBag.SortedReviews as IReadOnlyList<BoredGamers.Models.Review>
                                        ?? new List<BoredGamers.Models.Review>();
                                    var currentSort = (ViewBag.ReviewSort as string) ?? "newest";
                                }

                                <!--Review list -->
                                @if (sortedReviews.Any())
                                {
                                    <form method="get" class="mb-3 d-flex align-items-center gap-2">
                                        <label for="review-sort" class="form-label mb-0">Sort by:</label>
                                        <select name="sort" id="review-sort" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                                            <option value="newest" selected="@(currentSort == "newest")">Newest</option>
                                            <option value="rating-desc" selected="@(currentSort == "rating-desc")">Rating: High to Low</option>
                                            <option value="rating-asc" selected="@(currentSort == "rating-asc")">Rating: Low to High</option>
                                        </select>
                                    </form>

                                    <div class="d-flex flex-column gap-3">
                                        @foreach (var r in sortedReviews)
                                        {
                                            <div class="border rounded p-3 review-card">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <strong>@(r.User?.UserName ?? "Unknown user")</strong>

                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="badge bg-secondary review-rating">@r.Rating / 10</span>

                                                        @* ADDED: only show Edit button for the current user's own reviews *@
                                                        @if (User.Identity?.IsAuthenticated == true && r.UserId == currentUserId)
                                                        {
                                                            <a asp-controller="Reviews" asp-action="Edit" asp-route-id="@r.ReviewId"
                                                                   class="btn btn-sm btn-outline-primary">
                                                                <i class="bi bi-pencil me-1"></i>Edit
                                                            </a>

                                                            <form asp-controller="Reviews" asp-action="Delete" method="post"
                                                                class="d-inline" onsubmit="return confirm('Are you sure you want to delete this review?');">

                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="reviewId" value="@r.ReviewId" />
                                                                <input type="hidden" name="gameId" value="@Model.Id" />

                                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                                    <i class ="bi bi-trash me-1"></i>Delete
                                                                </button>
                                                            </form>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="text-muted small mb-2">@r.CreatedAt.ToLocalTime().ToString("g")</div>
                                                <div style="white-space: pre-line;">@r.Text</div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">No Reviews yet.</p>
                                }

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</section>