@model BoredGamers.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}
<section class="bg-dark text-white py-5">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="text-center mb-4">
                    <h1 class="display-5 fw-bold mb-3">Forgot Password</h1>
                    <p class="lead">Enter your email and we'll send you a reset link</p>
                </div>
                <div class="card bg-dark border-secondary">
                    <div class="card-body p-4">
                        <form asp-action="ForgotPassword" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">Email Address</label>
                                <input asp-for="Email" class="form-control form-control-lg"
                                       placeholder="Enter your email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-primary btn-lg">Send Reset Link</button>
                            </div>
                            <div class="text-center pt-3 border-top">
                                <a asp-action="Login" class="text-decoration-none">Back to Login</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}