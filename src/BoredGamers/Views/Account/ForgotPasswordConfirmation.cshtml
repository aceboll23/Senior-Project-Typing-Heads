@{
    ViewData["Title"] = "Check Your Email";
}
<section class="bg-dark text-white py-5">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center">
                <i class="bi bi-envelope-check display-1 text-success mb-4"></i>
                <h1 class="display-5 fw-bold mb-3">Check Your Email</h1>
                <p class="lead">If that email is registered, you'll receive a reset link shortly. It expires in 15 minutes.</p>
                <a asp-action="Login" class="btn btn-outline-light mt-3">Back to Login</a>
            </div>
        </div>
    </div>
</section>