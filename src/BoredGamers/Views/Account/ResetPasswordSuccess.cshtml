@{
    ViewData["Title"] = "Password Reset";
}
<section class="bg-dark text-white py-5">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center">
                <i class="bi bi-check-circle display-1 text-success mb-4"></i>
                <h1 class="display-5 fw-bold mb-3">Password Reset Successfully</h1>
                <p class="lead">Your password has been updated. You can now log in with your new password.</p>
                <a asp-action="Login" class="btn btn-primary mt-3">Go to Login</a>
            </div>
        </div>
    </div>
</section>