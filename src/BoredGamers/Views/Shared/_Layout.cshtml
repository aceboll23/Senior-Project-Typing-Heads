<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BoredGamers</title>

    <!-- Apply saved theme before render to prevent flash -->
    <script>
        (function () {
            if (localStorage.getItem('theme') === 'light') {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Custom CSS (loaded after Bootstrap to override with our theme variables) -->
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
        <div class="container">
            <!-- Logo -->
            <a asp-controller="Home" asp-action="Index" class="navbar-brand fw-bold">BoredGamers</a>

            <!-- Desktop right-side actions (always visible) -->
            <div class="d-flex align-items-center gap-2 order-lg-last">
                <!-- Theme Toggle -->
                <button id="themeToggle" class="theme-toggle" title="Toggle theme" onclick="toggleTheme()">
                    <i class="bi bi-sun icon-sun"></i>
                    <i class="bi bi-moon icon-moon"></i>
                </button>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <!-- Logged In: Icons (visible on desktop only — mobile sees them in offcanvas) -->
                    <div class="d-none d-lg-flex align-items-center gap-3">
                        <a asp-controller="Messages" asp-action="Index" class="btn btn-outline-light position-relative" title="Messages" id="messages-icon-link">
                            <i class="bi bi-envelope"></i>
                            @await Component.InvokeAsync("UnreadMessages")
                        </a>
                        <a asp-controller="Notification" asp-action="Notifications" class="btn btn-outline-light position-relative" title="Notifications" id="notifications-icon-link">
                            <i class="bi bi-bell"></i>
                            @await Component.InvokeAsync("UnreadNotifications")
                        </a>
                        <div class="dropdown">
                            <button class="btn btn-outline-light dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @await Component.InvokeAsync("UserAvatar")
                                <span>@User.Identity.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><h6 class="dropdown-header">@User.Identity.Name</h6></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index" asp-route-username="@User.Identity.Name"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                <li><a class="dropdown-item" asp-controller="Collection" asp-action="Index"><i class="bi bi-collection me-2"></i>My Collection</a></li>
                                <li><a class="dropdown-item" id="nav-friends-trades-link" asp-controller="Collection" asp-action="AllFriendTrades"><i class="bi bi-arrow-left-right me-2"></i>Friends' Trades</a></li>
                                <li><a class="dropdown-item" asp-controller="Friends" asp-action="Index"><i class="bi bi-people me-2"></i>Friends</a></li>
                                <li><a class="dropdown-item" asp-controller="SocialFeed" asp-action="Index"><i class="bi bi-newspaper me-2"></i>Social</a></li>
                                <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear me-2"></i>Settings</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item text-danger" style="border:none;background:none;cursor:pointer;text-align:left;width:100%;padding:0.25rem 1rem;">
                                            <i class="bi bi-box-arrow-right me-2"></i>Log Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Logged Out (desktop only) -->
                    <div class="d-none d-lg-flex align-items-center gap-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light">Log In</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Sign Up</a>
                    </div>
                }

                <!-- Mobile hamburger (opens offcanvas) -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-controls="mobileNav" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <!-- Desktop nav links (hidden on mobile) -->
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a asp-controller="GamesPage" asp-action="Index" class="nav-link">Games</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a asp-controller="Playgroup" asp-action="Index" class="nav-link">Groups</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Mobile Offcanvas Side Panel -->
    <div class="offcanvas offcanvas-end bg-dark text-white" tabindex="-1" id="mobileNav" aria-labelledby="mobileNavLabel" style="width: 280px;">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title" id="mobileNavLabel">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span>@User.Identity.Name</span>
                }
                else
                {
                    <span>Menu</span>
                }
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="navbar-nav">
                <li class="nav-item mb-1">
                    <a asp-controller="GamesPage" asp-action="Index" class="nav-link text-white py-2">
                        <i class="bi bi-controller me-2"></i>Games
                    </a>
                </li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item mb-1">
                        <a asp-controller="Playgroup" asp-action="Index" class="nav-link text-white py-2">
                            <i class="bi bi-people-fill me-2"></i>Groups
                        </a>
                    </li>
                    <li><hr class="border-secondary"></li>
                    <li class="nav-item mb-1">
                        <a asp-controller="Messages" asp-action="Index" class="nav-link text-white py-2 position-relative" title="Messages" id="messages-icon-link">
                            <i class="bi bi-envelope me-2"></i>Messages
                            @await Component.InvokeAsync("UnreadMessages")
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a asp-controller="Notification" asp-action="Notifications" class="nav-link text-white py-2 position-relative" title="Notifications" id="notifications-icon-link">
                            <i class="bi bi-bell me-2"></i>Notifications
                            @await Component.InvokeAsync("UnreadNotifications")
                        </a>
                    </li>
                    <li><hr class="border-secondary"></li>
                    <li class="nav-item mb-1">
                        <a asp-controller="Profile" asp-action="Index" asp-route-username="@User.Identity.Name" class="nav-link text-white py-2">
                            <i class="bi bi-person me-2"></i>My Profile
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a asp-controller="Collection" asp-action="Index" class="nav-link text-white py-2">
                            <i class="bi bi-collection me-2"></i>My Collection
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a asp-controller="Collection" asp-action="AllFriendTrades" class="nav-link text-white py-2">
                            <i class="bi bi-arrow-left-right me-2"></i>Friends' Trades
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a asp-controller="Friends" asp-action="Index" class="nav-link text-white py-2">
                            <i class="bi bi-people me-2"></i>Friends
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a asp-controller="SocialFeed" asp-action="Index" class="nav-link text-white py-2">
                            <i class="bi bi-newspaper me-2"></i>Social
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a asp-controller="Settings" asp-action="Index" class="nav-link text-white py-2">
                            <i class="bi bi-gear me-2"></i>Settings
                        </a>
                    </li>
                    <li><hr class="border-secondary"></li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-link nav-link text-danger py-2 w-100 text-start" style="text-decoration:none;">
                                <i class="bi bi-box-arrow-right me-2"></i>Log Out
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li><hr class="border-secondary"></li>
                    <li class="nav-item mb-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light w-100">Log In</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary w-100">Sign Up</a>
                    </li>
                }
            </ul>
        </div>
    </div>


    <!-- Main Content -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white py-3 border-top mt-auto">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small">
                <p class="mb-0">&copy; 2026 BoredGamers</p>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="About" class="text-white-50 text-decoration-none">About</a>
                    <a asp-controller="Home" asp-action="Contact" class="text-white-50 text-decoration-none">Contact</a>
                    <a asp-controller="Home" asp-action="Terms" class="text-white-50 text-decoration-none">Terms</a>
                </div>
                <a href="https://boardgamegeek.com" target="_blank" class="d-inline-block">
                    <img src="~/Images/powered_by_logo_04_XL.jpg" alt="Powered by BoardGameGeek" style="height: 28px; width: auto;" />
                </a>
            </div>
        </div>
    </footer>

    @if (User.Identity?.IsAuthenticated != true)
    {
    <!-- Login Modal -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content bg-dark">
                <div class="modal-header">
                    <h5 class="modal-title" id="loginModalLabel">Log In</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="loginForm">
                        <div class="mb-3">
                            <label for="loginEmail" class="form-label">Email or Username</label>
                            <input type="text" class="form-control" id="loginEmail" placeholder="Enter your email or username">
                        </div>
                        <div class="mb-3">
                            <label for="loginPassword" class="form-label">Password</label>
                            <input type="password" class="form-control" id="loginPassword" placeholder="Enter your password">
                        </div>
                        <div class="mb-3">
                            <a asp-controller="Account" asp-action="ForgotPassword" class="small">Forgot Password?</a>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Log In</button>
                    </form>
                    <div class="mt-3 text-center">
                        <button class="btn btn-outline-secondary btn-sm" id="quickLoginBtn">Quick Demo Login (skip form)</button>
                    </div>
                </div>
                <div class="modal-footer justify-content-center border-top">
                    <p class="small text-muted mb-0">
                        Don't have an account?
                        <a href="#" id="showRegisterLink">Sign Up</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Register Modal -->
    <div class="modal fade" id="registerModal" tabindex="-1" aria-labelledby="registerModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content bg-dark">
                <div class="modal-header">
                    <h5 class="modal-title" id="registerModalLabel">Create Account</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="registerForm">
                        <div class="mb-3">
                            <label for="registerUsername" class="form-label">Username</label>
                            <input type="text" class="form-control" id="registerUsername" placeholder="Choose a username">
                        </div>
                        <div class="mb-3">
                            <label for="registerEmail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="registerEmail" placeholder="Enter your email">
                        </div>
                        <div class="mb-3">
                            <label for="registerPassword" class="form-label">Password</label>
                            <input type="password" class="form-control" id="registerPassword" placeholder="Create a password">
                        </div>
                        <div class="mb-3">
                            <label for="registerConfirm" class="form-label">Confirm Password</label>
                            <input type="password" class="form-control" id="registerConfirm" placeholder="Confirm your password">
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Create Account</button>
                    </form>
                </div>
                <div class="modal-footer justify-content-center border-top">
                    <p class="small text-muted mb-0">
                        Already have an account?
                        <a href="#" id="showLoginLink">Log In</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
    }

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script>
            (function () {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/user-notifications")
                    .withAutomaticReconnect()
                    .build();

                function updateBadge(linkId, badgeId, count) {
                    const link = document.getElementById(linkId);
                    if (!link) return;

                    let badge = document.getElementById(badgeId);

                    if (count > 0) {
                        if (!badge) {
                            badge = document.createElement('span');
                            badge.id = badgeId;
                            badge.className = 'position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger';
                            link.appendChild(badge);
                        }
                        badge.textContent = count;
                    } else if (badge) {
                        badge.remove();
                    }
                }

                connection.on("UnreadMessagesUpdated", function (count) {
                    // Update both desktop and offcanvas if both are present
                    updateBadge('messages-icon-link', 'unread-messages-badge', count);
                });

                connection.on("UnreadNotificationsUpdated", function (count) {
                    updateBadge('notifications-icon-link', 'unread-notifications-badge', count);
                });

                connection.start().catch(function (err) {
                    console.error("UserNotificationHub connection failed:", err);
                });
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
