@model BoredGamers.Models.Review

@{
    ViewData["Title"] = "Edit Review";
}

<div class="container py-4">
    <h1 class="mb-4">Edit Review</h1>

    @if (TempData["ReviewError"] != null)
    {
        <div class="alert alert-danger">@TempData["ReviewError"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-controller="Reviews" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="reviewId" value="@Model.ReviewId" />
                <input type="hidden" name="gameId" value="@Model.GameId" />

                <div class="mb-3">
                    <label class="form-label" for="rating">Rating (1-10)</label>
                    <select class="form-select" id="rating" name="rating" required>
                        @for (int i = 1; i <= 10; i++)
                        {
                            if (i == Model.Rating)
                            {
                                <option value="@i" selected>@i</option>
                            }
                            else
                            {
                                <option value="@i">@i</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="text">Review</label>
                    <textarea class="form-control" id="text" name="text" rows="4" required>@Model.Text</textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>Save Changes
                    </button>

                    <a asp-controller="Games" asp-action="Details" asp-route-id="@Model.GameId" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>