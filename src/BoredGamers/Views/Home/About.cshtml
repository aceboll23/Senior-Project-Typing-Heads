@{
    ViewData["Title"] = "About BoredGamers";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">About BoredGamers</h1>
        <p class="lead text-muted">Your social hub for all things tabletop.</p>
        <hr class="w-25 mx-auto" />
    </div>

    <div class="row align-items-center mb-5">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <h2 class="fw-semibold mb-3">Why We Built This</h2>
            <p>
                BoredGamers was created for the deeply relatable problem of owning a pile of board games and still
                somehow saying, "I don't know what we should play." Our app helps players discover games, manage their
                collections, connect with friends, share posts, write reviews, plan game nights, and generally reduce
                the amount of time spent staring at a shelf in decision paralysis. Whether you are into intense strategy
                games, chaotic party games, or games where someone inevitably explains the rules wrong the first time,
                BoredGamers is built to help you find your next table adventure.
            </p>
            <p>
                At its heart, BoredGamers is a social hub for people who love cardboard, dice, meeples, tiny plastic
                pieces, and occasionally arguing over whether a rule was "definitely in the manual." Users can track
                what they own, see what their friends are playing, trade games, post about gaming victories or defeats,
                and organize game nights without needing a group chat that becomes 400 messages of "what time works for
                everyone?" We cannot promise your friends will stop taking forever on their turns, but we can help make
                finding, sharing, and playing games a little easier — and hopefully a lot more fun.
            </p>
        </div>
        <div class="col-lg-6 text-center">
            <img src="~/Images/team.png" alt="The Typing Heads Team" class="img-fluid rounded-4 shadow" />
        </div>
    </div>

    <div class="bg-dark text-white rounded-4 p-5 mt-4">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h2 class="fw-semibold mb-3">Meet the Team</h2>
                <p class="mb-4">
                    BoredGamers is proudly brought to you by <strong>Typing Heads</strong>, a highly professional and
                    only slightly chaotic development team. Together, they turned caffeine, code, merge conflicts, and
                    questionable naming decisions into the app you see before you.
                </p>
                <div class="row g-4">
                    <div class="col-sm-4 text-center">
                        <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center mb-2" style="width:64px;height:64px;">
                            <i class="bi bi-terminal-fill fs-4"></i>
                        </div>
                        <h6 class="fw-bold mb-0">Adler Ceboll</h6>
                        <small class="text-white-50">Fearless Git Commander</small>
                    </div>
                    <div class="col-sm-4 text-center">
                        <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center mb-2" style="width:64px;height:64px;">
                            <i class="bi bi-shield-fill fs-4"></i>
                        </div>
                        <h6 class="fw-bold mb-0">Ian Cooper</h6>
                        <small class="text-white-50">Brave &amp; Battle-Tested Team Lead</small>
                    </div>
                    <div class="col-sm-4 text-center">
                        <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center mb-2" style="width:64px;height:64px;">
                            <i class="bi bi-cpu-fill fs-4"></i>
                        </div>
                        <h6 class="fw-bold mb-0">Logan Montgomery</h6>
                        <small class="text-white-50">Mysterious &amp; Powerful AI Czar</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 text-center mt-4 mt-lg-0">
                <i class="bi bi-controller" style="font-size: 7rem; opacity: 0.15;"></i>
            </div>
        </div>
    </div>

</div>
