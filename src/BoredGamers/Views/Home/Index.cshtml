@model BoredGamers.Models.ViewModels.HomeIndexViewModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<BoredGamers.Models.User> SignInManager
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="bg-dark text-white py-5">
    <div class="container text-center py-5">
        <h1 class="display-4 fw-bold mb-3">Find Your Next Game Night</h1>
        <p class="lead mb-4">Discover games, build your collection, and coordinate with friends</p>

        <!-- Search Bar -->
        <div class="row justify-content-center mb-4">
    <div class="col-md-6">
        <!-- Game Search Form (shown by default) -->
        <form id="gameSearchForm" action="/Games/SearchResults" method="get" data-authenticated="@Json.Serialize(SignInManager.IsSignedIn(User))">>
            <div class="input-group input-group-lg">
                <!-- Dropdown to switch search type -->
                <button class="btn btn-outline-light dropdown-toggle" 
                        type="button" 
                        id="searchTypeBtn"
                        data-bs-toggle="dropdown" 
                        aria-expanded="false"
                        style="min-width: 110px;">
                    <i class="bi bi-controller me-1"></i> Games
                </button>
                <ul class="dropdown-menu" id="searchTypeMenu">
                    <li>
                        <a class="dropdown-item active" href="#" data-type="games">
                            <i class="bi bi-controller me-1"></i> Games
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="#" data-type="users">
                            <i class="bi bi-person me-1"></i> Users
                        </a>
                    </li>
                </ul>

                <input type="text" 
                       id="searchInput"
                       name="q" 
                       class="form-control" 
                       placeholder="Search games..."
                       autocomplete="off">
                <button type="submit" class="btn btn-primary" id="searchBtn">Search</button>
            </div>
        </form>

        <!-- User search dropdown results -->
        <div id="userSearchResults" class="dropdown-menu w-100 shadow" style="display:none; position:absolute; z-index:1000;">
            <!-- Results injected here by JS -->
        </div>
    </div>
</div>

        <!-- CTA Button -->
        <div class="d-flex justify-content-center">
            <button class="btn btn-outline-light btn-lg" data-bs-toggle="modal" data-bs-target="#registerModal">Sign Up</button>
        </div>
    </div>
</section>

<!-- Featured Games Section -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h3 mb-0">Featured Games</h2>
            <a asp-controller="Games" asp-action="Index" class="text-decoration-none">Explore All Games <i class="bi bi-arrow-right"></i></a>
        </div>
        @if (Model?.FeaturedGames == null || !Model.FeaturedGames.Any())
        {
            <!--Empty State (no crash if sync hasn't run yet) -->
            <div class ="alert alert-secondary" role="alert">
                No Games available yet.  Check back soon!
            </div>
        }
        else
        {
            <div class="row row-cols -2 row-cols-md-4 g-4">
                @foreach (var game in Model.FeaturedGames)
                {
                    <div class="col">
                        <a asp-controller="Games"
                           asp-action="Details"
                           asp-route-id="@game.Id"
                           class="card bg-dark text-white text decoration-none h-100">
                           
                           @{
                               //Prefer thumbnail if available; fallback to a local placeholder
                               var img = string.IsNullOrWhiteSpace(game.ThumbnailUrl)
                                  ? Url.Content("~/images/game-placeholder.png")
                                  : game.ThumbnailUrl;
                           }

                           <img src="@img" class="card-img-top" alt="@game.Name" />

                           <div class ="card-body">
                                <h6 class="card-title">@game.Name</h6>

                                <small class="text-muted">
                                    @game.BggNumVoters BGG voters
                                    @if (game.YearPublished.HasValue)
                                    {
                                        <span> | @game.YearPublished</span>
                                    }
                                </small>

                                @if (game.AverageRating.HasValue)
                                {
                                    <div class="mt-2">
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <span>@game.AverageRating.Value.ToString("0.0")/10</span>
                                    </div>
                                }
                           </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</section>


@section Scripts {
    <script src="~/js/search.js"></script>
}