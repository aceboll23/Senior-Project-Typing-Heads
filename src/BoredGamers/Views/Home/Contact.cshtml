@{
    ViewData["Title"] = "Contact Us";
}

<section class="py-5">
    <div class="container" style="max-width:800px;">

        @* Logo *@
        <div class="text-center mb-5">
            <img src="/images/Logo.png" alt="BoredGamers Logo" style="max-width:280px;width:100%;">
        </div>

        <h2 class="text-center mb-5">Meet the Team</h2>

        @* Adler *@
        <div class="card bg-dark mb-4">
            <div class="card-body">
                <div class="row align-items-center g-4">
                    <div class="col-auto">
                        <img src="/images/Adler.jpg" alt="Adler Ceboll"
                             class="rounded-circle"
                             style="width:140px;height:140px;object-fit:cover;">
                    </div>
                    <div class="col">
                        <h4 class="mb-2">Adler Ceboll</h4>
                        <div class="mb-1">
                            <i class="bi bi-envelope me-2 text-muted"></i>
                            <a href="mailto:cebolladler@gmail.com" class="text-light text-decoration-none">cebolladler@gmail.com</a>
                        </div>
                        <div>
                            <i class="bi bi-linkedin me-2 text-muted"></i>
                            <a href="https://www.linkedin.com/in/adler-ceboll-47799540b/" target="_blank" rel="noopener" class="text-light text-decoration-none">linkedin.com/in/adler-ceboll</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Ian *@
        <div class="card bg-dark mb-4">
            <div class="card-body">
                <div class="row align-items-center g-4">
                    <div class="col-auto">
                        <img src="/images/Ian.png" alt="Ian Cooper"
                             class="rounded-circle"
                             style="width:140px;height:140px;object-fit:cover;object-position:30% 15%;">
                    </div>
                    <div class="col">
                        <h4 class="mb-2">Ian Cooper</h4>
                        <div class="mb-1">
                            <i class="bi bi-envelope me-2 text-muted"></i>
                            <a href="mailto:iandcooper2@gmail.com" class="text-light text-decoration-none">iandcooper2@gmail.com</a>
                        </div>
                        <div>
                            <i class="bi bi-linkedin me-2 text-muted"></i>
                            <a href="https://www.linkedin.com/in/ian-cooper-bb7100218" target="_blank" rel="noopener" class="text-light text-decoration-none">linkedin.com/in/ian-cooper</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Logan *@
        <div class="card bg-dark mb-4">
            <div class="card-body">
                <div class="row align-items-center g-4">
                    <div class="col-auto">
                        <img src="/images/Logan.jpg" alt="Logan Montgomery"
                             class="rounded-circle"
                             style="width:140px;height:140px;object-fit:cover;">
                    </div>
                    <div class="col">
                        <h4 class="mb-2">Logan Montgomery</h4>
                        <div class="mb-1">
                            <i class="bi bi-envelope me-2 text-muted"></i>
                            <a href="mailto:loganmontgomery@gmail.com" class="text-light text-decoration-none">loganmontgomery@gmail.com</a>
                        </div>
                        <div>
                            <i class="bi bi-linkedin me-2 text-muted"></i>
                            <a href="https://www.linkedin.com/in/logan-montgomery-515609277" target="_blank" rel="noopener" class="text-light text-decoration-none">linkedin.com/in/logan-montgomery</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>
