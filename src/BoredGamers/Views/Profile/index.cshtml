@{
    ViewData["Title"] = ViewData["ProfileUsername"] + "'s Profile";
    var isOwnProfile = (bool)ViewData["IsOwnProfile"];
    var email = ViewData["Email"] as string;
    var firstName = ViewData["FirstName"] as string;
    var lastName = ViewData["LastName"] as string;
    var memberSince = ViewData["MemberSince"] as string;
    var username = ViewData["ProfileUsername"] as string;
}

<!-- Profile Header -->
<section class="py-4">
    <div class="container">
        <div class="row g-4">

            <!-- Avatar and Name -->
            <div class="col-md-4 text-center">
                <!-- Placeholder avatar using Bootstrap icon -->
                <div class="mb-3">
                    <i class="bi bi-person-circle" style="font-size: 6rem;"></i>
                </div>
                <h2>@username</h2>
                @if (!string.IsNullOrEmpty(firstName) || !string.IsNullOrEmpty(lastName))
                {
                    <p class="text-muted">@firstName @lastName</p>
                }
            </div>

            <!-- Profile Info -->
            <div class="col-md-8">
                <div class="card bg-dark">
                    <div class="card-body">
                        <h4 class="card-title mb-3">Profile Info</h4>

                        <div class="mb-2">
                            <strong>Member Since:</strong>
                            <span class="text-muted">@memberSince</span>
                        </div>

                        @if (isOwnProfile && !string.IsNullOrEmpty(email))
                        {
                            <div class="mb-2">
                                <strong>Email:</strong>
                                <span class="text-muted">@email</span>
                            </div>
                        }

                        <!-- Game Collection (placeholder for Ian's feature) -->
                        <div class="mb-2">
                            <strong>Games Owned:</strong>
                            <span class="text-muted">No games yet</span>
                        </div>
                    </div>
                </div>

                <!-- Friend Request Button (only on other users' profiles) -->
                @if (!isOwnProfile)
                {
                    <button id="addFriendBtn" class="btn btn-primary mt-3">
                        <i class="bi bi-person-plus me-1"></i>Add As Friend
                    </button>
                }
            </div>

        </div>
    </div>
</section>

<!--Adler You can remove this stuff as you see fit for your button-->
@section Scripts {
<script>
    $(document).ready(function () {
        $('#addFriendBtn').on('click', function () {
            var $btn = $(this);
            $btn.removeClass('btn-primary').addClass('btn-success');
            $btn.html('<i class="bi bi-check me-1"></i>Request Sent');
            $btn.prop('disabled', true);
        });
    });
</script>
}
