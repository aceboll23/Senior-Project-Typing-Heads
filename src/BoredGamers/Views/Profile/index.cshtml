@{
    ViewData["Title"] = ViewData["ProfileUsername"] + "'s Profile";
    var isOwnProfile = (bool)(ViewData["IsOwnProfile"] ?? false);
    var email = ViewData["Email"] as string;
    var firstName = ViewData["FirstName"] as string;
    var lastName = ViewData["LastName"] as string;
    var memberSince = ViewData["MemberSince"] as string;
    var username = ViewData["ProfileUsername"] as string;
    var avatarUrl = ViewData["AvatarUrl"] as string;
    var showEmail = ViewData["ShowEmail"] as bool? ?? false;
    var showRealName = ViewData["ShowRealName"] as bool? ?? true;
    var collection = ViewData["Collection"] as List<Game> ?? new List<Game>();
    var games = ViewData["Games"] as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var friendshipStatus = ViewData["FriendshipStatus"] as string;
    var friendshipRequesterId = ViewData["FriendshipRequesterId"] as int?;
    var currentUserProfileId = ViewData["CurrentUserProfileId"] as int?;
    var isSender = friendshipRequesterId == currentUserProfileId;
    var pendingRequests = ViewData["PendingRequests"] as List<object> ?? new List<object>();
    var profilePosts = ViewData["ProfilePosts"] as IReadOnlyList<BoredGamers.Models.ProfilePost> ?? new List<BoredGamers.Models.ProfilePost>();
    var postError = TempData["PostError"] as string;
    var hasBlocked = ViewData["HasBlocked"] as bool? ?? false;
    var blockSuccess = TempData["BlockSuccess"] as string;
    var blockError = TempData["BlockError"] as string;
    var avatarError = TempData["AvatarError"] as string;
}

<!-- Profile Header -->
<section class="py-4">
    <div class="container">
        <div class="row g-4">
            <!-- Avatar and Name -->
            <div class="col-md-4 text-center">
                <!-- Avatar - Use uploaded image if available, otherwise placeholder -->
                <div class="mb-3">
                    @if (isOwnProfile)
                    {
                        <form asp-controller="Profile" asp-action="UploadAvatar" method="post" enctype="multipart/form-data" id="avatarUploadForm">
                            @Html.AntiForgeryToken()
                            <input type="file" id="avatarFileInput" name="avatar" accept=".jpg,.jpeg,.png,.gif,.webp" style="display:none;" />
                            <button type="submit" id="avatarSubmitBtn" style="display:none;" aria-hidden="true"></button>
                            <div style="cursor:pointer; position:relative; display:inline-block;" onclick="document.getElementById('avatarFileInput').click();" title="Click to change profile picture">
                                @if (!string.IsNullOrEmpty(avatarUrl))
                                {
                                    <img id="profile-avatar-img" src="@avatarUrl" alt="@username" class="rounded-circle"
                                         style="width: 150px; height: 150px; object-fit: cover;">
                                }
                                else
                                {
                                    <div id="profile-avatar-placeholder" class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto"
                                         style="width: 150px; height: 150px; font-size: 4rem;">
                                        @username?.Substring(0, 1).ToUpper()
                                    </div>
                                }
                                <div class="rounded-circle d-flex align-items-center justify-content-center"
                                     style="position:absolute;bottom:0;right:0;width:36px;height:36px;background:rgba(0,0,0,0.6);">
                                    <i class="bi bi-camera text-white" style="font-size:1rem;"></i>
                                </div>
                            </div>
                        </form>
                        @if (!string.IsNullOrEmpty(avatarError))
                        {
                            <div class="alert alert-danger mt-2 py-1 px-2 small" id="avatar-error">@avatarError</div>
                        }
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(avatarUrl))
                        {
                            <img src="@avatarUrl" alt="@username" class="rounded-circle"
                                 style="width: 150px; height: 150px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto"
                                 style="width: 150px; height: 150px; font-size: 4rem;">
                                @username?.Substring(0, 1).ToUpper()
                            </div>
                        }
                    }
                </div>
                <h2>@username</h2>
                @if (showRealName && (!string.IsNullOrEmpty(firstName) || !string.IsNullOrEmpty(lastName)))
                {
                    <p class="text-muted">@firstName @lastName</p>
                }
            </div>

            <!-- Profile Info -->
            <div class="col-md-8">
                <div class="card bg-dark">
                    <div class="card-body">
                        <h4 class="card-title mb-3">Profile Info</h4>
                        <div class="mb-2">
                            <strong>Member Since:</strong>
                            <span class="text-muted">@memberSince</span>
                        </div>
                        @* Show email if it's own profile OR if user allows showing email *@
                        @if ((isOwnProfile || showEmail) && !string.IsNullOrEmpty(email))
                        {
                            <div class="mb-2">
                                <strong>Email:</strong>
                                <span class="text-muted">@email</span>
                            </div>
                        }

                        <!--Game Collection -->
                        <div class="mb-2">
                            <strong>Games Owned:</strong>

                            @if (isOwnProfile)
                            {
                                <a class="btn btn-outline-primary btn-sm ms-2" asp-controller="Collection"
                                       asp-action="Index">
                                    View My Collection
                                </a>
                            }
                            else
                            {
                                <a class="btn btn-outline-secondary btn-sm ms-2"
                                   asp-controller="Collection"
                                   asp-action="FriendCollection"
                                   asp-route-username="@username">
                                    View Collection
                                </a>
                                @if (friendshipStatus == "Accepted")
                                {
                                    <a class="btn btn-outline-success btn-sm ms-2"
                                       asp-controller="Collection"
                                       asp-action="FriendTrades"
                                       asp-route-username="@username"
                                       id="view-available-trades-btn">
                                        <i class="bi bi-arrow-left-right me-1"></i>View Available Trades
                                    </a>
                                }
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(blockSuccess))
                        {
                            <div class="alert alert-success mt-3"><i class="bi bi-check-circle me-2"></i>@blockSuccess</div>
                        }
                        @if (!string.IsNullOrEmpty(blockError))
                        {
                            <div class="alert alert-danger mt-3"><i class="bi bi-exclamation-circle me-2"></i>@blockError</div>
                        }

                        <!-- Friend Request Button (only on other users' profiles) -->
                        @if (!isOwnProfile)
                        {
                            <div class="mt-3" id="friendActionArea">
                                @if (friendshipStatus == "Accepted")
                                {
                                    <button class="btn btn-success" disabled>
                                        <i class="bi bi-people-fill me-1"></i>Friends
                                    </button>
                                    <a href="/Messages/Conversation/@username" class="btn btn-outline-light ms-2">
                                        <i class="bi bi-chat me-1"></i>Message
                                    </a>
                                }
                                else if (friendshipStatus == "Pending" && isSender)
                                {
                                    <button id="cancelRequestBtn" class="btn btn-secondary">
                                        <i class="bi bi-x-circle me-1"></i>Cancel Request
                                    </button>
                                }
                                else if (friendshipStatus == "Pending" && !isSender)
                                {
                                    <span class="text-muted fst-italic">This user has sent you a friend request.</span>
                                }
                                else
                                {
                                    <button id="addFriendBtn" class="btn btn-primary">
                                        <i class="bi bi-person-plus me-1"></i>Add As Friend
                                    </button>

                                }

                                @if (hasBlocked)
                                {
                                    <span class="badge bg-secondary ms-2">Blocked</span>
                                }
                                else
                                {
                                    <form asp-controller="Block" asp-action="Block" method="post" class="d-inline ms-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="targetUsername" value="@username" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" id="block-user-btn"
                                                onclick="return confirm('Block @username? This will remove any existing friendship.')">
                                            <i class="bi bi-slash-circle me-1"></i>Block User
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </div>

                </div>
            </div>

            <!-- Pending Friend Requests (only shown on own profile) -->
            @*
            @if (isOwnProfile && pendingRequests.Any())
            {
                <section class="py-4">
                    <div class="container">
                        <h4 class="mb-3">Friend Requests</h4>
                        <div id="pendingRequestsList">
                            @foreach (var req in pendingRequests)
                            {
                                var friendshipId = (int)req.GetType().GetProperty("FriendshipId")!.GetValue(req)!;
                                var requesterUsername = req.GetType().GetProperty("Username")!.GetValue(req) as string;
                                var requesterAvatar = req.GetType().GetProperty("AvatarUrl")!.GetValue(req) as string;
                                var requestedAt = req.GetType().GetProperty("RequestedAt")!.GetValue(req) as string;

                                <div class="card bg-dark mb-2 friend-request-card" id="request-@friendshipId">
                                    <div class="card-body d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(requesterAvatar))
                                            {
                                                <img src="@requesterAvatar" class="rounded-circle me-3"
                                                    style="width:48px;height:48px;object-fit:cover;">
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-3"
                                                    style="width:48px;height:48px;font-size:1.5rem;">
                                                    @requesterUsername?.Substring(0, 1).ToUpper()
                                                </div>
                                            }
                                            <div>
                                                <a href="/Profile/@requesterUsername" class="fw-bold text-white text-decoration-none">
                                                    @requesterUsername
                                                </a>
                                                <div class="text-muted small">Sent @requestedAt</div>
                                            </div>
                                        </div>
                                        <div>
                                            <button class="btn btn-success btn-sm me-2 accept-btn"
                                                    data-friendship-id="@friendshipId">
                                                <i class="bi bi-check-lg me-1"></i>Accept
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm decline-btn"
                                                    data-friendship-id="@friendshipId">
                                                <i class="bi bi-x-lg me-1"></i>Decline
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>
            }*@
        </section>

        
        <!-- Profile Posts -->
        <section class="py-4">
            <div class="container">
                <h4 class="mb-3">Posts</h4>

                @if (!string.IsNullOrEmpty(postError))
                {
                    <div class="alert alert-danger">@postError</div>
                }

                @if (isOwnProfile)
                {
                    <form asp-controller="ProfilePost" asp-action="Create" method="post" enctype="multipart/form-data" class="mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUsername" value="@username" />

                        <!-- Text content -->
                        <div class="mb-2 position-relative">
                            <textarea id="post-content" name="content" class="form-control"
                                      placeholder="Share a gaming update..." rows="3" maxlength="500"></textarea>
                            <small id="post-char-counter" class="text-muted position-absolute" style="bottom:6px;right:10px;">500</small>
                        </div>

                        <!-- Image upload -->
                        <div class="mb-2">
                            <label class="form-label small text-muted">Attach an image (optional)</label>
                            <input type="file" id="post-image-input" name="postImage" class="form-control form-control-sm"
                                   accept=".jpg,.jpeg,.png,.gif,.webp" />
                            <img id="post-preview-image" src="#" alt="Preview" class="mt-2 rounded d-none"
                                 style="max-height:200px;max-width:100%;object-fit:contain;" />
                        </div>

                        <!-- Category and game row -->
                        <div class="row g-2 mb-2">
                            <div class="col-sm-6">
                                <select id="post-category" name="category" class="form-select form-select-sm">
                                    <option value="0">— No tag —</option>
                                    <option value="1">Currently Playing</option>
                                    <option value="2">Want to Play</option>
                                    <option value="3">Completed</option>
                                    <option value="4">Top 10</option>
                                </select>
                            </div>
                            <div class="col-sm-6">
                                <select id="post-game" name="gameId" class="form-select form-select-sm">
                                    <option value="">— Link a game (optional) —</option>
                                    @foreach (var g in games)
                                    {
                                        <option value="@g.Id">@g.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <button type="submit" id="post-submit-btn" class="btn btn-primary">Post</button>
                    </form>
                }

                @if (profilePosts.Count == 0)
                {
                    <p class="text-muted">No posts yet.</p>
                }
                else
                {
                    @foreach (var post in profilePosts)
                    {
                        <div class="card bg-dark mb-2 profile-post-item">
                            <div class="card-body">
                                <!-- Category badge -->
                                @if (post.Category != BoredGamers.Models.PostCategory.None)
                                {
                                    var badgeColor = post.Category switch {
                                        BoredGamers.Models.PostCategory.CurrentlyPlaying => "success",
                                        BoredGamers.Models.PostCategory.WantToPlay => "info",
                                        BoredGamers.Models.PostCategory.Completed => "primary",
                                        BoredGamers.Models.PostCategory.Top10 => "warning",
                                        _ => "secondary"
                                    };
                                    var badgeLabel = post.Category switch {
                                        BoredGamers.Models.PostCategory.CurrentlyPlaying => "Currently Playing",
                                        BoredGamers.Models.PostCategory.WantToPlay => "Want to Play",
                                        BoredGamers.Models.PostCategory.Completed => "Completed",
                                        BoredGamers.Models.PostCategory.Top10 => "Top 10",
                                        _ => ""
                                    };
                                    <span class="badge bg-@badgeColor mb-2" id="post-category-badge-@post.Id">@badgeLabel</span>
                                }

                                <!-- Linked game -->
                                @if (post.Game != null)
                                {
                                    <div class="small text-muted mb-1" id="post-game-link-@post.Id">
                                        <i class="bi bi-controller me-1"></i>
                                        <a asp-controller="GamesPage" asp-action="Details" asp-route-id="@post.Game.BggGameId"
                                           class="text-muted text-decoration-none">@post.Game.Name</a>
                                    </div>
                                }

                                <!-- Text content -->
                                @if (!string.IsNullOrEmpty(post.Content))
                                {
                                    <p class="mb-1">@post.Content</p>
                                }

                                <!-- Image -->
                                @if (!string.IsNullOrEmpty(post.ImageUrl))
                                {
                                    <img src="@post.ImageUrl" alt="Post image" class="img-fluid rounded mb-2"
                                         style="max-height:400px;object-fit:contain;" id="post-image-@post.Id" />
                                }

                                <div class="d-flex align-items-center justify-content-between mt-1">
                                    <small class="text-muted">@post.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy 'at' h:mm tt")</small>
                                    @if (isOwnProfile)
                                    {
                                        <form asp-controller="ProfilePost" asp-action="Delete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="postId" value="@post.Id" />
                                            <input type="hidden" name="returnUsername" value="@username" />
                                            <button type="submit" id="delete-post-btn-@post.Id"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Delete this post?')">Delete</button>
                                        </form>
                                    }
                                    else if (User.Identity != null && User.Identity.IsAuthenticated)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary report-post-btn"
                                                data-post-id="@post.Id"
                                                title="Report this post">
                                            <i class="bi bi-flag me-1"></i>Report
                                        </button>
                                    }
                                </div>

                                @* Replies *@
                                @if (post.Replies.Any())
                                {
                                    <div class="mt-3 border-top border-secondary pt-3">
                                        @foreach (var reply in post.Replies.OrderBy(r => r.CreatedAt))
                                        {
                                            <div class="d-flex gap-2 mb-2" id="reply-@reply.Id">
                                                @if (!string.IsNullOrEmpty(reply.Author?.Profile?.AvatarUrl))
                                                {
                                                    <img src="@reply.Author.Profile.AvatarUrl" alt="@reply.Author.UserName"
                                                         class="rounded-circle flex-shrink-0"
                                                         style="width:28px;height:28px;object-fit:cover;">
                                                }
                                                else
                                                {
                                                    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center flex-shrink-0"
                                                         style="width:28px;height:28px;font-size:0.75rem;">
                                                        @(reply.Author?.UserName?.Substring(0, 1).ToUpper() ?? "?")
                                                    </div>
                                                }
                                                <div class="bg-secondary bg-opacity-25 rounded p-2 flex-grow-1">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <a asp-controller="Profile" asp-action="Index"
                                                           asp-route-username="@reply.Author?.UserName"
                                                           class="fw-semibold text-white text-decoration-none small">
                                                            @reply.Author?.UserName
                                                        </a>
                                                        <span class="text-muted" style="font-size:0.75rem;">
                                                            @reply.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy 'at' h:mm tt")
                                                        </span>
                                                    </div>
                                                    <p class="mb-0 small">@reply.Content</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @* Reply form — shown to authenticated users on all posts *@
                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                {
                                    <div class="mt-2">
                                        <form asp-controller="ProfilePost" asp-action="Reply" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="postId" value="@post.Id" />
                                            <input type="hidden" name="returnUsername" value="@username" />
                                            <div class="d-flex gap-2">
                                                <textarea name="content" class="form-control form-control-sm bg-dark text-light border-secondary"
                                                          rows="1" maxlength="500"
                                                          placeholder="Write a reply…"></textarea>
                                                <button type="submit" class="btn btn-sm btn-outline-primary flex-shrink-0">
                                                    <i class="bi bi-reply me-1"></i>Reply
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </section>

        @section Scripts {
        <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>
        <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Avatar upload
            var avatarInput = document.getElementById('avatarFileInput');
            if (avatarInput) {
                avatarInput.addEventListener('change', function () {
                    var form = document.getElementById('avatarUploadForm');
                    if (this.files && this.files.length > 0 && !form.dataset.manualSubmit) {
                        document.getElementById('avatarSubmitBtn').click();
                    }
                });
            }

            // Post character counter
            var postContent = document.getElementById('post-content');
            var counter = document.getElementById('post-char-counter');
            if (postContent && counter) {
                postContent.addEventListener('input', function () {
                    var remaining = 500 - this.value.length;
                    counter.textContent = remaining;
                    counter.style.color = remaining < 50 ? '#dc3545' : '';
                });
            }

            // Post image preview
            var postImageInput = document.getElementById('post-image-input');
            var postImagePreview = document.getElementById('post-preview-image');
            if (postImageInput && postImagePreview) {
                postImageInput.addEventListener('change', function () {
                    if (this.files && this.files[0]) {
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            postImagePreview.src = e.target.result;
                            postImagePreview.classList.remove('d-none');
                        };
                        reader.readAsDataURL(this.files[0]);
                    } else {
                        postImagePreview.classList.add('d-none');
                    }
                });
            }
        });
        $(document).ready(function () {
            const profileUsername = '@username';
            const token = $('input[name="__RequestVerificationToken"]').first().val();

            // Accept friend request
            @*
            $(document).on('click', '.accept-btn', function () {
                var $btn = $(this);
                var friendshipId = $btn.data('friendship-id');
                var $card = $('#request-' + friendshipId);
                $btn.prop('disabled', true);

                $.post('/FriendRequest/Accept',
                    { friendshipId: friendshipId, __RequestVerificationToken: token },
                    function (response) {
                        if (response.success) {
                            // Remove the card from the list "smoothly" ;)
                            $card.fadeOut(300, function () { $(this).remove(); });
                        } else {
                            alert(response.message);
                            $btn.prop('disabled', false);
                        }
                    }
                ).fail(function (xhr) {
                    console.log('Accept failed:', xhr.responseText);
                    $btn.prop('disabled', false);
                });
            });

            // Decline friend request
            $(document).on('click', '.decline-btn', function () {
                var $btn = $(this);
                var friendshipId = $btn.data('friendship-id');
                var $card = $('#request-' + friendshipId);
                $btn.prop('disabled', true);

                $.post('/FriendRequest/Decline',
                    { friendshipId: friendshipId, __RequestVerificationToken: token },
                    function (response) {
                        if (response.success) {
                            // Remove the card from the list "smoothly" ;)
                            $card.fadeOut(300, function () { $(this).remove(); });
                        } else {
                            alert(response.message);
                            $btn.prop('disabled', false);
                        }
                    }
                ).fail(function (xhr) {
                    console.log('Decline failed:', xhr.responseText);
                    $btn.prop('disabled', false);
                });
            });
            *@
            
            // Debug: check if button and token are found
            console.log('Button found:', $('#addFriendBtn').length);
            console.log('Token found:', token ? 'yes' : 'no');
            console.log('Username:', profileUsername);

            $('#addFriendBtn').on('click', function () {
                var $btn = $(this);
                console.log('Button clicked');
                $btn.prop('disabled', true);

                $.post('/FriendRequest/Send', 
                    { 
                        recipientUsername: profileUsername, 
                        __RequestVerificationToken: token 
                    },
                    function (response) {
                        console.log('Response:', response);
                        if (response.success) {
                            $btn.removeClass('btn-primary').addClass('btn-secondary');
                            $btn.html('<i class="bi bi-x-circle me-1"></i>Cancel Request');
                            $btn.attr('id', 'cancelRequestBtn');
                            $btn.prop('disabled', false);
                            bindCancelButton();
                        } else {
                            alert(response.message);
                            $btn.prop('disabled', false);
                        }
                    }
                ).fail(function(xhr, status, error) {
                    console.log('Request failed:', xhr.status, error);
                    console.log('Response text:', xhr.responseText);
                    $btn.prop('disabled', false);
                });
            });

            function bindCancelButton() {
                $('#cancelRequestBtn').off('click').on('click', function () {
                    var $btn = $(this);
                    $btn.prop('disabled', true);

                    $.post('/FriendRequest/Cancel',
                        { 
                            recipientUsername: profileUsername, 
                            __RequestVerificationToken: token 
                        },
                        function (response) {
                            console.log('Cancel response:', response);
                            if (response.success) {
                                $btn.removeClass('btn-secondary').addClass('btn-primary');
                                $btn.html('<i class="bi bi-person-plus me-1"></i>Add As Friend');
                                $btn.attr('id', 'addFriendBtn');
                                $btn.prop('disabled', false);
                            } else {
                                alert(response.message);
                                $btn.prop('disabled', false);
                            }
                        }
                    ).fail(function(xhr, status, error) {
                        console.log('Cancel failed:', xhr.status, error);
                        console.log('Response text:', xhr.responseText);
                        $btn.prop('disabled', false);
                    });
                });
            }

            bindCancelButton();
        });
        </script>
    }