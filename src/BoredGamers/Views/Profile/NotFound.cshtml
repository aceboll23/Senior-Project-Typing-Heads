@{
    ViewData["Title"] = "User Not Found";
}

<section class="py-5">
    <div class="container text-center">
        @* Bootstrap person icon *@
        <i class="bi bi-person-x" style="font-size: 3rem;"></i>
        <h2 class="mt-3">User Not Found</h2>
